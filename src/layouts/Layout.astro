---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(pagePath, Astro.site).href;
const socialImageUrl = new URL(`${base}/og.jpg`, Astro.site).href;
const socialImageAlt = 'Crestloom Textile — Rooted in craft. Ready for what’s next. Global sourcing for home textiles, Panipat, India.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!--
      `js` is what every CSS start state hangs off: set it and elements start
      hidden for GSAP to bring in. We only set it when the machine can actually
      animate — otherwise the page renders in its finished state, no timelines.
      Software rendering (Chrome with graphics acceleration off, or a
      blocklisted GPU) makes full-screen blurs and crossfades crawl.
    -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        // ?nomotion forces the static path, for checking it without a slow machine.
        var still =
          /[?&]nomotion\b/.test(location.search) ||
          matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!still) {
          try {
            var gl = document.createElement('canvas').getContext('webgl');
            var info = gl && gl.getExtension('WEBGL_debug_renderer_info');
            var renderer = info ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)) : '';
            // No WebGL at all, or a software rasteriser behind it.
            still = !gl || /swiftshader|llvmpipe|software|basic render/i.test(renderer);
          } catch (e) {
            still = true;
          }
        }
        html.classList.add(still ? 'no-motion' : 'js');
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crestloom Textile" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#f6f5f2" />
  </head>
  <body>
    <script>
      import '../scripts/reveal';
    </script>
    <div class="page-wrapper">
      <main class="main-wrapper">
        <slot />
      </main>
    </div>
  </body>
</html>
