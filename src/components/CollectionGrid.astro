---
import ProductCard from './ProductCard.astro';
import { products } from '../data/collection';
const orderedProducts = [...products.filter(p => p.code.endsWith('-001')), ...products.filter(p => !p.code.endsWith('-001'))];
---
<div class="collection-grid" id="collection-grid" aria-label="Collection products">
  {orderedProducts.map(product => <ProductCard {...product} overview={product.code.endsWith('-001')} />)}
</div>
<div class="collection-grid_sentinel" aria-hidden="true"></div>
<style>
  .collection-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .collection-grid.is-filtered { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .collection-grid_sentinel { height: 1px; margin-top: -5rem; }
  .collection-grid_sentinel[hidden] { display: none; }
  @media (max-width: 991px) { .collection-grid, .collection-grid.is-filtered { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .collection-grid { gap: .96rem; } }
</style>
