---
/**
 * ProductCard — a collection tile (Figma "All / Product / …", "All / Lifestyle / …").
 * Size comes from the grid; the card fills its slot. Hover: charcoal overlay,
 * "View catalog" rises in with underline + arrow. Click opens the catalog popup (later).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  label: string;
  category: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const { image, alt, label, category, widths = [302, 416, 604, 832], sizes = '(min-width: 992px) 22vw, 100vw', class: className } = Astro.props;
---

<button type="button" class:list={['product-card', className]} data-catalog={category} data-reveal>
  <Image src={image} alt={alt} class="product-card_image" widths={widths} sizes={sizes} />
  <span class="product-card_overlay" aria-hidden="true"></span>
  <Badge size="md" class="product-card_badge">{label}</Badge>
  <span class="product-card_action">
    <Button as="span" variant="ghost-white">View catalog</Button>
  </span>
</button>

<style>
  .product-card {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: clip;
    background-color: var(--color--charcoal-black);
    color: var(--color--offwhite);
    text-align: left;
    cursor: pointer;
  }
  .product-card_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1000ms var(--ease--apple);
  }
  .product-card_overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color--charcoal-black);
    opacity: 0;
    transition: opacity 600ms var(--ease--apple);
  }
  .product-card > :global(.product-card_badge) {
    position: absolute;
    top: 1.25rem;                     /* 20 */
    left: 1.25rem;
  }
  .product-card_action {
    position: absolute;
    left: 1.5rem;                     /* 24 */
    bottom: 1.5rem;
    transform: translateY(calc(100% + 1.5rem));
    opacity: 0;
    transition: transform 700ms var(--ease--apple), opacity 500ms var(--ease--apple);
  }

  .product-card:hover .product-card_image,
  .product-card:focus-visible .product-card_image { transform: scale(1.04); }
  .product-card:hover .product-card_overlay,
  .product-card:focus-visible .product-card_overlay { opacity: 0.3; }
  .product-card:hover .product-card_action,
  .product-card:focus-visible .product-card_action { transform: translateY(0); opacity: 1; }
  /* the button follows the card's hover */
  .product-card:hover :global(.button_icon),
  .product-card:focus-visible :global(.button_icon) { transform: translateX(0.25rem); }
  .product-card:hover :global(.button_label::after),
  .product-card:focus-visible :global(.button_label::after) { transform: scaleX(1); transform-origin: left; }
</style>
