---
/**
 * CollectionCard — Figma "Collections / {Name} / Image".
 * size="large": 28 padding (20 bottom). size="small": 24 padding (12 bottom).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  badge: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  size?: 'large' | 'small';
}
const { title, badge, href, image, alt, size = 'small' } = Astro.props;
---

<a href={href} class:list={['collection-card', `is-${size}`]} data-reveal>
  <Image
    src={image}
    alt={alt}
    class="collection-card_image"
    widths={size === 'large' ? [800, 1200, 1600] : [504, 800, 1008]}
    sizes={size === 'large' ? '(min-width: 992px) 56vw, 100vw' : '(min-width: 992px) 35vw, 100vw'}
  />
  <div class="collection-card_overlay" aria-hidden="true"></div>
  <Badge class="collection-card_badge">{badge}</Badge>
  <div class="collection-card_content">
    <h3 class="heading-style-h3 collection-card_title">{title}</h3>
    <div class="collection-card_action">
      <Button as="span" variant="ghost-white">Explore {title}</Button>
    </div>
  </div>
</a>

<style>
  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    overflow: clip;
    background-color: var(--color--charcoal-black);
    color: var(--color--offwhite);
  }
  .collection-card.is-large { padding: 1.75rem 1.75rem 1.25rem; }  /* 28 / 28 / 20 */
  .collection-card.is-small { padding: 1.5rem 1.5rem 0.75rem; }    /* 24 / 24 / 12 */

  .collection-card_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1000ms var(--ease--apple);
  }
  .collection-card:hover .collection-card_image,
  .collection-card:focus-visible .collection-card_image {
    transform: scale(1.04);
  }
  .collection-card > :global(.collection-card_badge),
  .collection-card_content {
    position: relative;
    z-index: 1;
  }

  /* --- Hover: overlay fades in; the action rises from below the card and
         lifts the title with it. At rest the content block sits lower by the
         action's height + gap, so only the title is visible. --- */
  .collection-card_overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color--charcoal-black);
    opacity: 0;
    transition: opacity 600ms var(--ease--apple);
  }
  .collection-card_content {
    --action-offset: 2.0625rem;       /* 17 button line + 16 gap */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;                        /* 16 */
    transform: translateY(var(--action-offset));
    transition: transform 700ms var(--ease--apple);
  }
  .collection-card_action {
    opacity: 0;
    transition: opacity 500ms var(--ease--apple);
  }
  .collection-card_title { color: var(--color--offwhite); }

  .collection-card:hover .collection-card_overlay,
  .collection-card:focus-visible .collection-card_overlay { opacity: 0.3; }
  .collection-card:hover .collection-card_content,
  .collection-card:focus-visible .collection-card_content { transform: translateY(0); }
  .collection-card:hover .collection-card_action,
  .collection-card:focus-visible .collection-card_action { opacity: 1; }
  /* the button follows the card's hover, not its own */
  .collection-card:hover :global(.button),
  .collection-card:focus-visible :global(.button) { color: var(--color--sandy-gold); }
  .collection-card:hover :global(.button_icon),
  .collection-card:focus-visible :global(.button_icon) { transform: translateX(0.25rem); }
  .collection-card:hover :global(.button_label::after),
  .collection-card:focus-visible :global(.button_label::after) { transform: scaleX(1); transform-origin: left; }
</style>
