---
/**
 * ContactForm — Figma Contact right column and responsive form.
 * Labels sit above a 1px rule; the input lives between them.
 */
import Lines from './Lines.astro';
import Button from './Button.astro';
const returnUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contact/?submitted=true`, Astro.site).href;
---

<div class="contact-form" data-reveal-group>
  <Lines tag="h2" class="heading-style-h3" lines={['Tell us what you’re looking for.']} />

  <form class="contact-form_form" action="https://formsubmit.co/info@crestloom.in" method="POST" data-return-url={returnUrl} novalidate data-reveal>
    <div class="contact-form_fields">
      <div class="contact-form_row">
        <div class="contact-form_field is-first-name">
          <label for="first-name" class="text-style-nav">First name</label>
          <input id="first-name" name="firstName" type="text" autocomplete="given-name" required />
        </div>
        <div class="contact-form_field is-company">
          <label for="company" class="text-style-nav">Company</label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
      </div>
      <div class="contact-form_field">
        <label for="email" class="text-style-nav">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="contact-form_field is-message">
        <label for="message" class="text-style-nav">Message</label>
        <textarea id="message" name="message" rows="2" required></textarea>
      </div>
      <!-- honeypot: hidden from people, filled by bots -->
      <div class="contact-form_hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <p class="text-size-small contact-form_note">Include the category, approximate quantity and desired timeline if known.</p>
    <p class="text-size-small contact-form_error" role="alert" hidden></p>
    <p class="text-size-small contact-form_status" role="status" hidden></p>

    <Button variant="filled-cyan" class="contact-form_submit">Send enquiry</Button>
  </form>


</div>

<script>
  import { messageContainsLink } from '../lib/enquiry';

  const root = document.querySelector<HTMLElement>('.contact-form');
  const form = root?.querySelector<HTMLFormElement>('form');
  if (root && form) {
    const error = form.querySelector<HTMLElement>('.contact-form_error')!;
    const status = form.querySelector<HTMLElement>('.contact-form_status')!;
    const submit = form.querySelector<HTMLButtonElement>('.contact-form_submit')!;
    let sending = false;
    if (new URLSearchParams(location.search).get('submitted') === 'true') {
      status.textContent = 'Thank you. Your enquiry has been submitted.';
      status.hidden = false;
      history.replaceState(null, '', location.pathname + location.hash);
    }

    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      sending = false;
      submit.disabled = false;
      form.removeAttribute('aria-busy');
      status.hidden = true;
    });

    const showError = (msg: string) => { error.textContent = msg; error.hidden = false; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      error.hidden = true;
      status.hidden = true;
      form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')]
        .filter((el) => !el.checkValidity() || !el.value.trim());
      if (invalid.length) {
        invalid.forEach((el) => el.closest('.contact-form_field')?.classList.add('is-invalid'));
        showError(invalid.some((el) => el.type === 'email' && el.value) ? 'Please enter a valid email address.' : 'Please fill in the highlighted fields.');
        invalid[0].focus();
        return;
      }

      if (data._honey?.trim()) return;
      if (messageContainsLink(data.message)) {
        showError('Please remove links from your message and try again.');
        return;
      }
      sending = true;
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.textContent = 'Opening secure spam verification…';
      status.hidden = false;
      // Use the provider's standard route, including its spam verification.
      // Construct an allowlisted payload so the honeypot never leaves the browser.
      const deliveryForm = document.createElement('form');
      deliveryForm.method = 'POST';
      deliveryForm.action = form.action;
      deliveryForm.hidden = true;
      const fields = {
        firstName: data.firstName.trim(),
        email: data.email.trim(),
        company: data.company.trim(),
        message: data.message.trim(),
        _subject: 'Crestloom website enquiry',
        _template: 'table',
        _next: form.dataset.returnUrl!,
      };
      for (const [name, value] of Object.entries(fields)) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        deliveryForm.append(input);
      }
      document.body.append(deliveryForm);
      deliveryForm.submit();
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    width: 40rem;                     /* 640 */
  }
  .contact-form_form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;                      /* 40 */
  }
  .contact-form_fields {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;                      /* 72 between field rows */
    width: 100%;
  }
  .contact-form_row {
    display: flex;
    gap: 2rem;                        /* 32 */
  }
  .contact-form_row > .is-first-name { flex: 0 0 18.5rem; }  /* 296 */
  .contact-form_row > .is-company    { flex: 0 0 19.5rem; }  /* 312 */

  /* --- Field: label over a rule; input fills the 36 between --- */
  .contact-form_field {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .contact-form_field label { color: var(--color--text); }
  .contact-form_field input,
  .contact-form_field textarea {
    width: 100%;
    height: 2.3125rem;
    padding: 0.5rem 0 0.25rem;
    border: 0;
    border-bottom: 1px solid rgb(40 40 42 / 0.28);
    border-radius: 0;
    background: transparent;
    color: var(--color--text);
    font-family: var(--font--body);
    font-size: 1rem;
    line-height: 150%;
    letter-spacing: -0.04em;
    outline: none;
    resize: none;
    transition: border-color 500ms var(--ease--apple);
  }
  .is-message textarea { height: 4.5625rem; }   /* 72: label→rule gap in Figma */
  .contact-form_field input:focus,
  .contact-form_field textarea:focus { border-bottom-color: var(--color--text); }
  .contact-form_field.is-invalid input,
  .contact-form_field.is-invalid textarea { border-bottom-color: var(--color--sandy-brown); }

  .contact-form_hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form_note {
    margin-top: -0.75rem;             /* 28 from the rule instead of 40 */
    opacity: 0.7;
  }
  .contact-form_error { color: var(--color--sandy-brown); margin-top: -1.5rem; }

  .contact-form_success {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 30rem;
  }
  .contact-form_form[hidden],
  .contact-form_success[hidden],
  .contact-form_error[hidden],
  .contact-form_status[hidden] { display: none; }
  @media (max-width: 991px) {
    .contact-form { width: 100%; min-width: 0; gap: 3.5rem; }
    .contact-form :global(h2) { font-size: 2.125rem; }
    .contact-form_form { gap: 1.5rem; width: 100%; }
    .contact-form_row { gap: 1.5rem; }
    .contact-form_row > .contact-form_field { flex: 1 1 0; min-width: 0; }
    .contact-form_note { margin-top: 0; }
    .contact-form :global(.contact-form_submit) { width: 100%; justify-content: center; }
  }
  @media (max-width: 767px) {
    .contact-form { gap: 2.88rem; }
    .contact-form :global(h2) { font-size: 1.8rem; }
    .contact-form_form { gap: 1.44rem; }
    .contact-form_fields { gap: 4.32rem; }
    .contact-form_row { flex-direction: column; gap: 1.92rem; }
    .contact-form_field label { font-size: 0.84rem; }
    .contact-form_field input, .contact-form_field textarea { height: 2.22rem; font-size: 0.96rem; }
    .is-message textarea { height: 4.38rem; }
    .contact-form_note, .contact-form_error { font-size: 0.84rem; }
  }
</style>
