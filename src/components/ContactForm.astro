---
/**
 * ContactForm — Figma Contact right column and responsive form.
 * Labels sit above a 1px rule; the input lives between them.
 */
import Lines from './Lines.astro';
import Button from './Button.astro';
import sendingIcon from '../assets/contact-sending.svg';
const callbackPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/enquiry-received/`;
---

<div class="contact-form" data-reveal-group>
  <div class="contact-form_entry">
  <Lines tag="h2" class="heading-style-h3" lines={['Tell us what you’re looking for.']} />

  <form class="contact-form_form" data-callback-path={callbackPath} novalidate data-reveal>
    <div class="contact-form_fields">
      <div class="contact-form_row">
        <div class="contact-form_field is-first-name">
          <label for="first-name" class="text-style-nav">First name</label>
          <input id="first-name" name="firstName" type="text" autocomplete="given-name" required />
        </div>
        <div class="contact-form_field is-company">
          <label for="company" class="text-style-nav">Company</label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
      </div>
      <div class="contact-form_field">
        <label for="email" class="text-style-nav">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="contact-form_field is-message">
        <label for="message" class="text-style-nav">Message</label>
        <textarea id="message" name="message" rows="2" required></textarea>
      </div>
      <!-- honeypot: hidden from people, filled by bots -->
      <div class="contact-form_hp" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <p class="text-size-small contact-form_note">Include the category, approximate quantity and desired timeline if known.</p>
    <div class="contact-form_feedback is-sending" role="status" hidden>
      <p class="contact-form_feedback-title"><img src={sendingIcon.src} width="16" height="16" alt="" class="contact-form_spinner" />Sending your enquiry</p>
      <p>Please keep this page open. Your details will stay in the form.</p>
    </div>
    <div class="contact-form_feedback is-error" role="alert" hidden>
      <p class="contact-form_feedback-title"><span class="contact-form_error-mark" aria-hidden="true">!</span><span>We couldn’t send your enquiry.</span></p>
      <p class="contact-form_error-detail">Your details are still here. Please try again, or email <a href="mailto:info@crestloom.in">info@crestloom.in</a>.</p>
    </div>

    <Button type="submit" variant="filled-cyan" class="contact-form_submit" disabled>Send enquiry</Button>
  </form>
  <noscript><p>Please enable JavaScript to send an enquiry from this page.</p></noscript>
  </div>
  <div class="contact-form_success" role="status" hidden>
    <p class="contact-form_success-tag">Enquiry received</p>
    <h2 class="heading-style-h3" tabindex="-1">Thank you for getting in touch.</h2>
    <p class="text-size-regular">Your enquiry has been submitted. Our team will be in touch by email.</p>
    <Button type="button" variant="filled-cyan" class="contact-form_again">Send another enquiry</Button>
  </div>
</div>

<script>
  import { messageContainsLink } from '../lib/enquiry';
  import { sendContactEnquiry } from '../lib/contact-delivery';
  import { ScrollTrigger } from '../scripts/motion';
  const root = document.querySelector<HTMLElement>('.contact-form');
  const form = root?.querySelector<HTMLFormElement>('form');
  if (root && form) {
    const entry = root.querySelector<HTMLElement>('.contact-form_entry')!;
    const success = root.querySelector<HTMLElement>('.contact-form_success')!;
    const sendingPanel = form.querySelector<HTMLElement>('.is-sending')!;
    const errorPanel = form.querySelector<HTMLElement>('.is-error')!;
    const errorDetail = errorPanel.querySelector<HTMLElement>('.contact-form_error-detail')!;
    const submit = form.querySelector<HTMLButtonElement>('.contact-form_submit')!;
    const note = form.querySelector<HTMLElement>('.contact-form_note')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
    const setLabel = (label: string) => submit.querySelectorAll('.button_label-text').forEach(n => { n.textContent = label; });
    let sending = false;
    submit.disabled = false;
    const refresh = () => requestAnimationFrame(() => ScrollTrigger.refresh());
    const setSending = (value: boolean) => {
      sending = value; submit.disabled = value;
      form.setAttribute('aria-busy', String(value));
      fields.forEach(field => { field.readOnly = value; });
      sendingPanel.hidden = !value; note.hidden = value || !errorPanel.hidden;
      root.dataset.state = value ? 'sending' : 'idle';
      setLabel(value ? 'Sending…' : 'Send enquiry');
      refresh();
    };
    const showError = (message?: string) => {
      errorPanel.hidden = false; note.hidden = true;
      if (message) errorDetail.textContent = message;
      else {
        errorDetail.replaceChildren('Your details are still here. Please try again, or email ');
        const email = document.createElement('a');
        email.href = 'mailto:info@crestloom.in'; email.textContent = 'info@crestloom.in';
        errorDetail.append(email, '.');
      }
      root.dataset.state = 'error'; setLabel('Try again'); refresh();
    };
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      errorPanel.hidden = true;
      form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
      fields.forEach(field => field.removeAttribute('aria-invalid'));
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data._honey?.trim()) return;
      const invalid = fields.filter(field => field.required && (!field.checkValidity() || !field.value.trim()));
      if (invalid.length) {
        invalid.forEach(field => { field.setAttribute('aria-invalid', 'true'); field.closest('.contact-form_field')?.classList.add('is-invalid'); });
        showError(invalid.some(field => field.type === 'email' && field.value) ? 'Please enter a valid email address.' : 'Please fill in the highlighted fields.');
        invalid[0].focus(); return;
      }
      if (messageContainsLink(data.message)) {
        showError('Please remove links from your message and try again.');
        form.querySelector<HTMLTextAreaElement>('#message')?.focus(); return;
      }
      setSending(true);
      try {
        await sendContactEnquiry({ firstName: data.firstName, company: data.company, email: data.email, message: data.message }, form.dataset.callbackPath!);
        setSending(false); form.reset(); entry.hidden = true; success.hidden = false;
        root.dataset.state = 'success'; success.querySelector<HTMLElement>('h2')?.focus({ preventScroll: true }); refresh();
      } catch {
        setSending(false); showError();
      }
    });
    root.querySelector('.contact-form_again')?.addEventListener('click', () => {
      success.hidden = true; entry.hidden = false; errorPanel.hidden = true; note.hidden = false;
      root.dataset.state = 'idle'; setLabel('Send enquiry'); fields[0].focus({ preventScroll: true }); refresh();
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    width: 40rem;                     /* 640 */
  }
  .contact-form_entry { display: flex; flex-direction: column; gap: 4rem; width: 100%; }
  .contact-form_form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;                      /* 40 */
  }
  .contact-form_fields {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;                      /* 72 between field rows */
    width: 100%;
  }
  .contact-form_row {
    display: flex;
    gap: 2rem;                        /* 32 */
  }
  .contact-form_row > .is-first-name { flex: 0 0 18.5rem; }  /* 296 */
  .contact-form_row > .is-company    { flex: 0 0 19.5rem; }  /* 312 */

  /* --- Field: label over a rule; input fills the 36 between --- */
  .contact-form_field {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .contact-form_field label { color: var(--color--text); }
  .contact-form_field input,
  .contact-form_field textarea {
    width: 100%;
    height: 2.3125rem;
    padding: 0.5rem 0 0.25rem;
    border: 0;
    border-bottom: 1px solid rgb(40 40 42 / 0.28);
    border-radius: 0;
    background: transparent;
    color: var(--color--text);
    font-family: var(--font--body);
    font-size: 1rem;
    line-height: 150%;
    letter-spacing: -0.04em;
    outline: none;
    resize: none;
    transition: border-color 500ms var(--ease--apple);
  }
  .is-message textarea { height: 4.5625rem; }   /* 72: label→rule gap in Figma */
  .contact-form_field input:focus,
  .contact-form_field textarea:focus { border-bottom-color: var(--color--text); }
  .contact-form_field.is-invalid input,
  .contact-form_field.is-invalid textarea { border-bottom-color: var(--color--sandy-brown); }

  .contact-form_hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form_note {
    margin-top: -0.75rem;             /* 28 from the rule instead of 40 */
    opacity: 0.7;
  }
  .contact-form_feedback { display: flex; flex-direction: column; gap: .5rem; padding: 1rem; width: 100%; margin-top: -.75rem; font: 400 .875rem/150% var(--font--body); letter-spacing: -.04em; }
  .contact-form_feedback-title { display: flex; align-items: center; gap: .625rem; font: 500 .875rem/120% var(--font--accent); letter-spacing: 0; }
  .is-sending .contact-form_feedback-title { color: var(--color--cyan-blue); }
  .contact-form_spinner { width: 1rem; height: 1rem; flex-shrink: 0; animation: contact-spin 1s linear infinite; }
  .contact-form_error-mark { width: 1rem; flex-shrink: 0; font-size: 1.125rem; }
  .contact-form_feedback a { text-decoration: underline; text-underline-offset: .15em; }
  .contact-form :global(.contact-form_submit:disabled) { opacity: 1; cursor: progress; }
  .contact-form[data-state='sending'] :global(.button_icon), .contact-form[data-state='error'] :global(.contact-form_submit .button_icon) { display: none; }
  .contact-form :global(.contact-form_submit) { min-width: 10.6875rem; justify-content: center; }
  @keyframes contact-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .contact-form_spinner { animation: none; } }
  .contact-form_success-tag { font: 500 .75rem/120% var(--font--accent); letter-spacing: .18em; text-transform: uppercase; color: var(--color--sandy-brown); }

  .contact-form_success {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    padding-top: 3.5rem;
    align-items: flex-start;
  }
  .contact-form_entry[hidden],
  .contact-form_feedback[hidden],
  .contact-form_note[hidden],
  .contact-form_form[hidden],
  .contact-form_success[hidden],
  .contact-form_error[hidden],
  .contact-form_status[hidden] { display: none; }
  @media (max-width: 991px) {
    .contact-form { width: 100%; min-width: 0; gap: 3.5rem; }
    .contact-form_entry { gap: 3.5rem; }
    .contact-form :global(h2) { font-size: 2.125rem; }
    .contact-form_form { gap: 1.5rem; width: 100%; }
    .contact-form_row { gap: 1.5rem; }
    .contact-form_row > .contact-form_field { flex: 1 1 0; min-width: 0; }
    .contact-form_note { margin-top: 0; }
    .contact-form :global(.contact-form_submit) { width: 100%; justify-content: center; }
  }
  @media (max-width: 767px) {
    .contact-form { gap: 2.88rem; }
    .contact-form_entry { gap: 2.88rem; }
    .contact-form_feedback { font-size: .84rem; padding: .96rem; margin-top: 0; }
    .contact-form_success { padding-top: 1.92rem; gap: 1.44rem; }
    .contact-form_success :global(h2) { font-size: 1.92rem; line-height: 110%; }
    .contact-form_success :global(.button) { width: 100%; justify-content: center; }
    .contact-form :global(h2) { font-size: 1.8rem; }
    .contact-form_form { gap: 1.44rem; }
    .contact-form_fields { gap: 4.32rem; }
    .contact-form_row { flex-direction: column; gap: 1.92rem; }
    .contact-form_field label { font-size: 0.84rem; }
    .contact-form_field input, .contact-form_field textarea { height: 2.22rem; font-size: 0.96rem; }
    .is-message textarea { height: 4.38rem; }
    .contact-form_note, .contact-form_error { font-size: 0.84rem; }
  }
</style>
