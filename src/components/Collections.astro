---
import Lines from './Lines.astro';
/**
 * Collections — Figma "Collections" (122:16), 1440 × 1212.
 * Static images for now; swaps to Supabase categories later.
 */
import CollectionCard from './CollectionCard.astro';
import Button from './Button.astro';
import living from '../assets/home/collection-living.webp';
import rugs from '../assets/home/collection-rugs.webp';
import linen from '../assets/home/collection-bath.webp';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const collections = {
  living: { title: 'Living', badge: 'Throws',  image: living, alt: 'Textured throw and patterned cushions on a linen sofa', href: `${base}/collections` },
  rugs:   { title: 'Rugs',   badge: 'Rugs',   image: rugs,   alt: 'Patterned area rug under a round coffee table',       href: `${base}/collections` },
  linen:  { title: 'Bath',  badge: 'Towels', image: linen,  alt: 'Folded towels beside a sunlit bath',               href: `${base}/collections` },
};
---

<section class="collections padding-global padding-section-large" id="collections" data-reveal-section>
  <div class="container-large collections_inner">
    <header class="collections_header" data-reveal-group>
      <div class="collections_heading-block">
        <Lines class="text-style-tagline text-color-sandy-brown" lines={['Our collections']} />
        <Lines tag="h2" class="heading-style-h2" lines={['Textiles for', 'considered spaces.']} />
      </div>
      <p class="text-size-large collections_intro" data-reveal="fade">
        Explore a curated range of home textiles, sourced for brands and retailers worldwide.
      </p>
    </header>

    <div class="collections_body">
      <div class="collections_grid" data-reveal-group>
        <CollectionCard {...collections.living} size="large" />
        <div class="collections_column">
          <CollectionCard {...collections.rugs} />
          <CollectionCard {...collections.linen} />
        </div>
      </div>
      <Button href={`${base}/collections`} variant="ghost-black" data-reveal>Explore all collections</Button>
    </div>
  </div>
</section>

<style>
  .collections {
    background-color: var(--color--offwhite);
  }
  .collections_inner {
    display: flex;
    flex-direction: column;
    gap: 4rem;                        /* 64 */
  }

  /* --- Header --- */
  .collections_header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .collections_heading-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 25.0625rem;                  /* 364 */
  }
  .collections_intro {
    width: 31.5rem;                   /* 504 */
    opacity: 0.85;
  }

  /* --- Grid --- */
  .collections_body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;                      /* 40 */
  }
  .collections_grid {
    display: flex;
    gap: 1.5rem;                      /* 24 */
    width: 100%;
    height: 45.875rem;                /* 734 */
  }
  .collections_grid > :global(.collection-card) { flex: 1 1 0; }
  .collections_column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;                      /* 24 */
    width: 31.5rem;                   /* 504 */
    flex-shrink: 0;
  }
  .collections_column > :global(.collection-card) { flex: 1 1 0; }
</style>
