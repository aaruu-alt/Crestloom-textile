---
import Lines from './Lines.astro';
/**
 * Selected Works — Figma "Selected Works" (126:2), 1440 × 1100.
 * Static images for now; may swap to Supabase later.
 */
import BlurImage from './BlurImage.astro';
import Button from './Button.astro';
import throwImg from '../assets/home/work-throw.webp';
import cushionImg from '../assets/home/work-cushion.webp';
import poufImg from '../assets/home/work-pouf.webp';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const works = [
  { category: 'Living',  title: 'Woven floral throw', image: throwImg,   alt: 'Woven floral throw draped over a wooden stool' },
  { category: 'Cushion', title: 'Botanical cushion',  image: cushionImg, alt: 'Botanical print cushion on a wooden stool' },
  { category: 'Pouf',    title: 'Patterned pouf',     image: poufImg,    alt: 'Patterned textile on a wooden stool' },
];
---

<section class="selected-works padding-global" id="selected-works" data-reveal-section>
  <div class="container-large selected-works_inner">
    <header class="selected-works_header" data-reveal-group>
      <div class="selected-works_heading-block">
        <Lines class="text-style-tagline text-color-sandy-brown" lines={['Selected works']} />
        <Lines tag="h2" class="heading-style-h2" lines={['Where craft meet the home']} />
      </div>
      <Button href={`${base}/collections`} variant="ghost-black" class="selected-works_desktop-link">View selected works</Button>
    </header>

    <ol class="selected-works_grid" data-reveal-group>
      {works.map((w, i) => (
        <li class="selected-works_item" data-reveal>
          <div class="selected-works_frame">
            <BlurImage
              src={w.image}
              alt={w.alt}
              class="selected-works_image"
              widths={[416, 832]}
              sizes="(min-width: 992px) 29vw, 100vw"
            />
          </div>
          <div class="selected-works_caption">
            <p class="text-style-tagline text-color-sandy-brown selected-works_index">
              {String(i + 1).padStart(2, '0')}&nbsp;&nbsp;/&nbsp;&nbsp;{w.category}
            </p>
            <h3 class="heading-style-h4">{w.title}</h3>
          </div>
        </li>
      ))}
    </ol>
    <div class="selected-works_pagination" aria-label="Selected works slides">
      {works.map((w, i) => <button type="button" aria-label={`Show ${w.title}`} aria-pressed={i === 0 ? "true" : "false"} data-work-slide={i}></button>)}
    </div>

    <Button href={`${base}/collections`} variant="ghost-black" class="selected-works_mobile-link" data-reveal>View selected works</Button>
  </div>
</section>

<style>
  .selected-works {
    background-color: var(--color--offwhite);
    padding-top: 6.25rem;             /* 100 */
    padding-bottom: 4rem;             /* 64 */
  }
  .selected-works_inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5rem;                        /* 80 */
  }

  /* --- Header --- */
  .selected-works_header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }
  .selected-works_heading-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: auto;
  }
  .selected-works_intro {
    width: 31.5rem;                   /* 504 */
    opacity: 0.85;
  }

  /* --- Grid --- */
  .selected-works_grid {
    display: flex;
    gap: 2.5rem;                      /* 40 */
    width: 100%;
  }
  .selected-works_item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;                        /* 32 */
  }
  .selected-works_frame {
    position: relative;
    width: 100%;
    height: 31.25rem;                 /* 500 */
    overflow: clip;
  }
  .selected-works_frame > :global(.selected-works_image) {
    width: 100%;
    height: 100%;
    transition: transform 1000ms var(--ease--apple);
  }

  .selected-works_item:hover .selected-works_frame > :global(.selected-works_image) {
    transform: scale(1.03);
  }

  .selected-works_caption {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;                    /* 18 */
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('.selected-works_grid');
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-work-slide]')];
  if (track) {
    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      const item = track.children[index] as HTMLElement;
      track.scrollTo({ left: item.offsetLeft - (track.children[0] as HTMLElement).offsetLeft, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }));
    track.addEventListener('scroll', () => {
      const width = (track.children[0] as HTMLElement).getBoundingClientRect().width + 16;
      const active = Math.round(track.scrollLeft / width);
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === active)));
    }, { passive: true });
  }
</script>
