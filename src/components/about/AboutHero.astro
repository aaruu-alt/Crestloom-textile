---
/**
 * About / Hero — Figma 146:331, 1440 × 820. Copy block right-aligned to the container.
 * Copy reveals via the shared load timeline; the image settles on its own.
 */
import { Image } from 'astro:assets';
import Lines from '../Lines.astro';
import heroImage from '../../assets/about-hero.png';
---

<section class="about-hero" data-reveal-section>
  <Image src={heroImage} alt="Sunlit park in Panipat with a stone terrace and memorial" class="about-hero_image" widths={[800, 1200, 1662]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="about-hero_overlay" aria-hidden="true"></div>
  <div class="about-hero_overlay-diagonal" aria-hidden="true"></div>

  <div class="about-hero_content padding-global">
    <div class="container-large about-hero_inner">
      <div class="about-hero_copy" data-reveal-group>
        <div class="about-hero_heading-block">
          <Lines class="text-style-tagline text-color-sandy-gold" lines={['About Crestloom']} />
          <Lines tag="h1" class="heading-style-h2 about-hero_heading" lines={['Grounded in Panipat.', 'Built for what comes next.']} />
        </div>
        <p class="text-size-large about-hero_intro" data-reveal="fade">
          A new sourcing company shaped by textile knowledge, material understanding, and close coordination.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-hero {
    position: relative;
    height: 51.25rem;                 /* 820 */
    background-color: var(--color--charcoal-black);
    color: var(--color--offwhite);
    overflow: clip;
  }
  .about-hero_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(html.js) .about-hero:not(.is-loaded) .about-hero_image { transform: scale(1.06); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .about-hero_image { transform: none; }
  }
  .about-hero_overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to bottom, rgb(0 0 0 / 0) 0%, rgb(0 0 0 / 0.73) 100%);
  }
  .about-hero_overlay-diagonal {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(-51.03deg, rgb(0 0 0 / 0) 13.27%, rgb(0 0 0 / 0) 69.39%, rgb(0 0 0 / 0.5) 122.02%);
  }
  .about-hero_content {
    position: relative;
    z-index: 1;
    padding-top: 28.5625rem;          /* 457 */
  }
  .about-hero_inner { display: flex; justify-content: flex-end; }
  .about-hero_copy {
    display: flex;
    flex-direction: column;
    gap: 3.25rem;                     /* 52 */
    width: 34.375rem;                 /* 550 */
  }
  .about-hero_heading-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;                      /* 24 */
  }
  .about-hero_heading { color: var(--color--offwhite); }
  .about-hero_intro { width: 31.25rem; }   /* 500 */
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';
  const hero = document.querySelector<HTMLElement>('.about-hero');
  const image = hero?.querySelector('.about-hero_image');
  if (hero && image && !reducedMotion) {
    gsap.to(image, { scale: 1, duration: 2.4, delay: 0.15, onComplete: () => { hero.classList.add('is-loaded'); gsap.set(image, { clearProps: 'all' }); } });
  }
</script>
