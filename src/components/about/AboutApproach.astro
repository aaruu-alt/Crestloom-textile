---
import Lines from '../Lines.astro';
const steps = ['Understanding your request', 'Choosing the right manufacturing partner', 'Sampling & product development', 'Quotation & order confirmation', 'Product monitoring & inspection', 'Packing & shipping'];
---
<section class="about-approach padding-global" id="process" data-reveal-section>
  <div class="container-large about-approach_inner">
    <div class="about-approach_copy" data-reveal-group>
      <div class="about-approach_heading-block">
        <Lines class="text-style-tagline text-color-sandy-brown" lines={['Our method']} />
        <Lines tag="h2" class="heading-style-h2" lines={['How we work together']} />
      </div>
      <p class="text-size-large" data-reveal="fade">We take your ideas and requirements through to a finished product, coordinating every thing from quality expectations to final destination.</p>
    </div>
    <ol class="about-approach_steps" data-reveal-group>
      {steps.map(step => <li class="about-approach_step" data-reveal><h3 class="heading-style-h4">{step}</h3></li>)}
    </ol>
  </div>
</section>
