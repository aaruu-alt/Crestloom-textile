---
import { Image } from 'astro:assets';
import Lines from '../Lines.astro';
import textileStudy from '../../assets/about-textile-study.webp';
const statements = [
  { title: 'Textile Expertise', body: 'We understand your requirements in details and recommend the right fit for you.' },
  { title: 'Trusted Supplier Network', body: 'Long lasting relationships with factory in and around Panipat, India where Industry is based.' },
  { title: 'Product Development', body: 'Products developed to your specifications from samples to bulk productions.' },
  { title: 'Full Transparency', body: 'Clear Communication at every stage, with regular updates so you always where your order stands all through one point of contact.' },
  { title: 'Close Monitoring', body: 'We follow your order from the factory floor through final inspection.' },
  { title: 'Our Aim', body: 'We aim to become your long term sourcing partner and grow together' },
];
---
<section class="about-origin padding-global" data-reveal-section>
  <div class="container-large about-origin_inner">
    <Lines tag="h2" class="heading-style-h1 about-origin_heading" lines={['Why Crestloom']} />
    <div class="about-origin_spread">
      <Image src={textileStudy} alt="Textile samples and woven rugs arranged on a studio table" class="about-origin_image" widths={[496, 688, 992, 1376]} sizes="(max-width: 991px) 100vw, 35vw" />
      <div class="about-origin_statements" data-reveal-group>
        {statements.map(statement => (
          <article class="about-origin_statement" data-reveal>
            <span class="about-origin_mark" aria-hidden="true"></span>
            <h3>{statement.title}</h3>
            <p>{statement.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
