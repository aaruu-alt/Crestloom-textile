---
/**
 * Navbar — Figma "Navbar" (154:678). Left links / centred wordmark / right links.
 * `theme="light"` = offwhite text for use over dark imagery (hero).
 */
import Wordmark from './Wordmark.astro';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const left = [
  { label: 'Collections', href: `${base}/#collections` },
  { label: 'Sourcing', href: `${base}/#sourcing` },
  { label: 'Our process', href: `${base}/#process` },
];
const right = [
  { label: 'About', href: `${base}/#about` },
  { label: 'Contact', href: `${base}/#contact` },
];

/** Mark a link active when its path (ignoring #hash) matches the current page. */
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  const path = href.split('#')[0].replace(/\/$/, '');
  return path !== '' && path !== base && path === current;
};
---

<header class:list={['navbar', `is-${theme}`]}>
  <nav class="navbar_left" aria-label="Primary">
    {left.map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <Wordmark href={`${base}/`} class="navbar_brand" />

  <nav class="navbar_right" aria-label="Secondary">
    {right.map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <button class="text-style-nav navbar_toggle" type="button" aria-expanded="false" aria-controls="navbar-menu">
    Menu
  </button>

  <div class="navbar_menu" id="navbar-menu" hidden>
    {[...left, ...right].map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const nav = document.querySelector<HTMLElement>('.navbar');
  if (nav) {
    // --- Scroll: transparent over the hero, offwhite bar once it's scrolled past ---
    const styles = getComputedStyle(document.documentElement);
    const token = (name: string) => styles.getPropertyValue(name).trim();

    const transparent = {
      backgroundColor: 'rgba(246, 245, 242, 0)',
      color: token('--color--offwhite'),
      '--wordmark-color': token('--color--offwhite'),
      '--wordmark-accent': token('--color--sandy-gold'),
    };
    const solid = {
      backgroundColor: token('--color--offwhite'),
      color: token('--color--charcoal-black'),
      '--wordmark-color': token('--color--charcoal-black'),
      '--wordmark-accent': token('--color--sandy-brown'),
    };
    const tween = { duration: 0.4, ease: 'power4.inOut', overwrite: 'auto' as const };

    const hero = document.querySelector<HTMLElement>('.hero');
    const setSolid = (on: boolean, instant = false) =>
      instant ? gsap.set(nav, on ? solid : transparent) : gsap.to(nav, { ...(on ? solid : transparent), ...tween });

    const trigger = ScrollTrigger.create({
      // switch when the hero's bottom edge reaches the bottom of the navbar
      start: () => (hero ? hero.offsetHeight - nav.offsetHeight : 1),
      end: 'max',
      onToggle: (self) => setSolid(self.isActive),
    });
    setSolid(trigger.isActive, true);

    // --- Mobile menu toggle ---
    const toggle = nav.querySelector<HTMLButtonElement>('.navbar_toggle');
    const menu = nav.querySelector<HTMLElement>('.navbar_menu');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.textContent = open ? 'Menu' : 'Close';
      if (menu) menu.hidden = open;
    });
  }
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 6.25rem;                  /* 100 */
    padding: 0 3.5rem;                /* 56 — matches padding-global */
  }
  .navbar.is-light {
    color: var(--color--offwhite);
    --wordmark-color: var(--color--offwhite);
    --wordmark-accent: var(--color--sandy-gold);
  }
  .navbar.is-dark {
    color: var(--color--text);
    --wordmark-color: var(--color--text);
    --wordmark-accent: var(--color--gold);
  }

  .navbar_left,
  .navbar_right {
    display: flex;
    align-items: center;
    gap: 2.125rem;                    /* 34 */
    width: 26.875rem;                 /* 430 — keeps the wordmark centred */
  }
  .navbar_right { justify-content: flex-end; }

  .navbar_toggle,
  .navbar_menu { display: none; }

  /* --- Tablet: tighter link columns --- */
  @media (max-width: 991px) {
    .navbar { padding: 0 2.5rem; }
    .navbar_left,
    .navbar_right { width: auto; gap: 1.5rem; }
  }

  /* --- Mobile: wordmark + menu toggle (no mobile design yet — sensible default) --- */
  @media (max-width: 767px) {
    .navbar { padding: 0 1.25rem; height: 5rem; }
    .navbar_left,
    .navbar_right { display: none; }
    .navbar_toggle { display: block; }
    .navbar_menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.5rem 1.25rem 2rem;
      background-color: var(--color--charcoal-black);
      color: var(--color--offwhite);
    }
    .navbar_menu[hidden] { display: none; }
  }
</style>
