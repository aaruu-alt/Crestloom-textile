---
/**
 * Navbar — Figma "Navbar" (154:678). Left links / centred wordmark / right links.
 * `theme="light"` = offwhite text for use over dark imagery (hero).
 */
import Wordmark from './Wordmark.astro';
import { routes } from '../lib/routes';

interface Props {
  theme?: 'light' | 'dark';
}
const { theme = 'light' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const left = [
  { label: 'Collections', href: routes.collections },
  { label: 'Our process', href: routes.process },
];
const right = [
  { label: 'About', href: routes.about },
  { label: 'Contact', href: routes.contact },
];

/** Mark a link active only when it is a page (no #hash) and its path matches the current page. */
const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  const path = href.replace(/\/$/, '');
  return path !== '' && path !== base && path === current;
};
---

<header class:list={['navbar', `is-${theme}`]}>
  <nav class="navbar_left" aria-label="Primary">
    {left.map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <Wordmark href={routes.home} class="navbar_brand" />

  <nav class="navbar_right" aria-label="Secondary">
    {right.map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <button class="text-style-nav navbar_toggle" type="button" aria-expanded="false" aria-controls="navbar-menu">
    <span class="navbar_toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="navbar_toggle-label">Menu</span>
  </button>

  <div class="navbar_menu" id="navbar-menu" hidden>
    <p class="navbar_explore">Explore</p>
    {[...left, ...right].map((l) => <a href={l.href} class="text-style-nav text-link navbar_link" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a href="mailto:info@crestloom.in" class="navbar_email">info@crestloom.in</a>
  </div>
</header>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/motion';

  const nav = document.querySelector<HTMLElement>('.navbar');
  if (nav) {
    // --- Scroll: transparent over the hero, offwhite bar once it's scrolled past ---
    const styles = getComputedStyle(document.documentElement);
    const token = (name: string) => styles.getPropertyValue(name).trim();

    // Dark theme (pages without a hero): text is charcoal from the start.
    const dark = nav.classList.contains('is-dark');
    const transparent = {
      backgroundColor: 'rgba(246, 245, 242, 0)',
      color: token(dark ? '--color--charcoal-black' : '--color--offwhite'),
      '--wordmark-color': token(dark ? '--color--charcoal-black' : '--color--offwhite'),
      '--wordmark-accent': token(dark ? '--color--sandy-brown' : '--color--sandy-gold'),
    };
    const solid = {
      backgroundColor: token('--color--offwhite'),
      color: token('--color--charcoal-black'),
      '--wordmark-color': token('--color--charcoal-black'),
      '--wordmark-accent': token('--color--sandy-brown'),
    };
    // Soft, decelerating ease — long enough to read as a change of state, not a flicker.
    const tweenIn  = { duration: 0.7, ease: 'apple', overwrite: 'auto' as const };
    const tweenOut = { duration: 0.5, ease: 'apple', overwrite: 'auto' as const };

    const setSolid = (on: boolean, instant = false) => {
      const state = on || nav.classList.contains('is-menu-open') || nav.classList.contains('is-menu-closing') ? solid : transparent;
      gsap.killTweensOf(nav, 'backgroundColor,color,--wordmark-color,--wordmark-accent');
      return instant ? gsap.set(nav, state) : gsap.to(nav, { ...state, ...(on ? tweenIn : tweenOut) });
    };

    const trigger = ScrollTrigger.create({
      start: 20,                      // switch once the page has scrolled 20px
      end: 999999,                    // never "leave" at the bottom of the page
      onEnter: () => setSolid(true),
      onLeaveBack: () => setSolid(false),
    });
    setSolid(trigger.isActive, true);
    const syncScrolled = () => nav.classList.toggle('is-scrolled', window.scrollY > 20);
    window.addEventListener('scroll', syncScrolled, { passive: true });
    syncScrolled();

    // --- Load: drop in (the hero timeline does this on pages that have one) ---
    if (!document.querySelector('.hero')) {
      gsap.to(nav, { y: 0, opacity: 1, duration: 1, delay: 0.2 });
    }

    // --- Scroll-spy: anchor links to sections on this page get aria-current while in view ---
    const here = location.pathname.replace(/\/$/, '');
    const anchorLinks = [...nav.querySelectorAll<HTMLAnchorElement>('.navbar_link[href*="#"]')];
    const byHash = new Map<string, HTMLAnchorElement[]>();
    anchorLinks.forEach((a) => {
      const url = new URL(a.href);
      if (url.pathname.replace(/\/$/, '') !== here || !url.hash) return;
      byHash.set(url.hash.slice(1), [...(byHash.get(url.hash.slice(1)) ?? []), a]);
    });
    byHash.forEach((links, id) => {
      const target = document.getElementById(id);
      if (!target) return;
      ScrollTrigger.create({
        trigger: target,
        start: 'top 50%',
        end: 'bottom 50%',
        onToggle: (self) => links.forEach((a) => self.isActive ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')),
      });
    });

    // Navigation remains operable independently of animation preferences.
    const toggle = nav.querySelector<HTMLButtonElement>('.navbar_toggle');
    const menu = nav.querySelector<HTMLElement>('.navbar_menu');
    let menuAnimation: Animation | undefined;
    let previousOverflow = '';
    const setOpen = (open: boolean) => {
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      const label = toggle?.querySelector('.navbar_toggle-label');
      if (label) label.textContent = open ? 'Close' : 'Menu';
      const currentOpacity = menu && !menu.hidden ? getComputedStyle(menu).opacity : '0';
      const currentTransform = menu && !menu.hidden ? getComputedStyle(menu).transform : 'translateY(-1rem)';
      menuAnimation?.cancel();
      if (open) {
        if (!nav.classList.contains('is-menu-open') && !nav.classList.contains('is-menu-closing')) {
          previousOverflow = document.body.style.overflow;
        }
        nav.classList.remove('is-menu-closing');
        nav.classList.add('is-menu-open');
        document.body.style.overflow = 'hidden';
        if (menu) { menu.hidden = false; menu.inert = false; }
      } else {
        nav.classList.remove('is-menu-open');
        nav.classList.toggle('is-menu-closing', !!menu && !menu.hidden);
        if (menu) menu.inert = true;
      }
      setSolid(open || window.scrollY > 20, true);
      const finish = () => {
        if (!open) {
          if (menu) menu.hidden = true;
          nav.classList.remove('is-menu-closing');
          document.body.style.overflow = previousOverflow;
          setSolid(window.scrollY > 20, true);
        }
      };
      if (menu && !menu.hidden) {
        menuAnimation = menu.animate([
          { opacity: currentOpacity, transform: currentTransform },
          { opacity: open ? 1 : 0, transform: open ? 'translateY(0)' : 'translateY(-1rem)' },
        ], { duration: reducedMotion ? 0 : open ? 1000 : 800, easing: token('--ease--apple'), fill: 'both' });
        menuAnimation.onfinish = finish;
      } else finish();
    };
    toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
    nav.addEventListener('keydown', event => { if (event.key === 'Escape') { setOpen(false); toggle?.focus(); } });
    matchMedia('(min-width: 992px)').addEventListener('change', event => { if (event.matches) setOpen(false); });

  }
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3.5rem 1rem;     /* 20 top / 56 sides / 16 bottom */
  }
  :global(html.js) .navbar { opacity: 0; transform: translateY(-0.75rem); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .navbar { opacity: 1; transform: none; }
  }
  .navbar.is-light {
    color: var(--color--offwhite);
    --wordmark-color: var(--color--offwhite);
    --wordmark-accent: var(--color--sandy-gold);
  }
  .navbar.is-dark {
    color: var(--color--text);
    --wordmark-color: var(--color--text);
    --wordmark-accent: var(--color--gold);
  }

  .navbar_left,
  .navbar_right {
    display: flex;
    align-items: center;
    gap: 2.125rem;                    /* 34 */
    width: 26.875rem;                 /* 430 — keeps the wordmark centred */
  }
  .navbar_right { justify-content: flex-end; }

  .navbar_toggle,
  .navbar_menu { display: none; }

  /* --- Tablet: tighter link columns --- */
  @media (max-width: 991px) {
    .navbar { padding: 1.25rem 2.5rem 1rem; }
    .navbar_left,
    .navbar_right { width: auto; gap: 1.5rem; }
  }

  /* --- Mobile: wordmark + menu toggle (no mobile design yet — sensible default) --- */
  @media (max-width: 767px) {
    .navbar { padding: 1.25rem 1.25rem 1rem; }
    .navbar_left,
    .navbar_right { display: none; }
    .navbar_toggle { display: block; }
    .navbar_menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.5rem 1.25rem 2rem;
      background-color: var(--color--charcoal-black);
      color: var(--color--offwhite);
    }
    .navbar_menu[hidden] { display: none; }
  }
  :global(.site-responsive) .navbar_toggle-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 991px) {
    :global(.site-responsive) .navbar_left, :global(.site-responsive) .navbar_right { display: none; }
    :global(.site-responsive) .navbar_toggle { display: block; padding: .625rem 0 .625rem .625rem; }
    :global(.site-responsive) .navbar_toggle-icon { display: flex; flex-direction: column; align-items: flex-end; gap: .3125rem; }
    :global(.site-responsive) .navbar_toggle-icon span { width: 1.625rem; height: .09375rem; background: currentColor; }
    :global(.site-responsive) .navbar_toggle-icon span:nth-child(2) { width: 1.25rem; }
    :global(.site-responsive) .navbar_menu:not([hidden]) { position: absolute; top: 100%; left: 0; right: 0; display: flex; flex-direction: column; gap: 2rem; padding: 2rem 2.5rem 3rem; background: var(--color--offwhite); color: var(--color--charcoal-black); align-items: center; justify-content: center; height: calc(100svh - 5.875rem); border-top: 1px solid rgb(23 23 22 / .18); overflow-y: auto; }
    :global(.site-responsive) :global(.navbar_brand) { width: 13.929rem; }
  }
  @media (max-width: 767px) {
    :global(.site-responsive) .navbar { padding: .75rem 1rem; height: 4.75rem; }
    :global(.site-responsive) :global(.navbar_brand) { width: 11.4375rem; height: 3.25rem; }
    :global(.site-responsive) .navbar_menu:not([hidden]) { padding-inline: 1rem; }
  }
  :global(.site-responsive) .navbar_explore { font: 500 .6875rem/120% var(--font--accent); letter-spacing: .24em; text-transform: uppercase; color: var(--color--sandy-brown); }
  :global(.site-responsive) .navbar_email { font: 500 .75rem/120% var(--font--accent); letter-spacing: .12em; text-transform: uppercase; }
  @media (max-width: 991px) {
    :global(.site-responsive) .navbar_menu .navbar_link { font: 500 2.5rem/100% var(--font--heading); letter-spacing: .01em; }
    :global(.site-responsive) .navbar_menu:not([hidden]) { gap: 1.125rem; }
    :global(.site-responsive) .navbar_explore { margin-bottom: .625rem; }
    :global(.site-responsive) .navbar_email { margin-top: .625rem; }
    :global(.site-responsive) .is-menu-open .navbar_toggle-icon span:first-child { transform: translateY(.40625rem) rotate(45deg); }
    :global(.site-responsive) .is-menu-open .navbar_toggle-icon span:nth-child(2) { opacity: 0; }
    :global(.site-responsive) .is-menu-open .navbar_toggle-icon span:last-child { transform: translateY(-.40625rem) rotate(-45deg); }
  }
  @media (max-width: 767px) {
    :global(.site-responsive) .navbar_menu:not([hidden]) { height: calc(100svh - 4.75rem); gap: 1.375rem; }
    :global(.site-responsive) .navbar_menu .navbar_link { font-size: 2.125rem; }
    :global(.site-responsive) .navbar_email { font-size: .6875rem; }
  }
  :global(.site-responsive) .navbar.is-scrolled,
  :global(.site-responsive) .navbar.is-menu-open,
  :global(.site-responsive) .navbar.is-menu-closing {
    background-color: var(--color--offwhite) !important;
    color: var(--color--charcoal-black) !important;
    --wordmark-color: var(--color--charcoal-black) !important;
    --wordmark-accent: var(--color--sandy-brown) !important;
  }
  :global(.site-responsive) .navbar_toggle-icon span {
    transition: transform 800ms var(--ease--apple), opacity 600ms var(--ease--apple);
  }
  :global(.site-responsive) .navbar_link[aria-current] { color: var(--color--sandy-brown); }
  @media (max-width: 991px) {
    :global(.site-responsive) .navbar { height: 5.875rem; }
    :global(.site-responsive) .navbar_menu:not([hidden]) { justify-content: safe center; }
  }
  @media (max-width: 767px) { :global(.site-responsive) .navbar { height: 4.75rem; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.site-responsive) .navbar_toggle-icon span { transition: none; }
  }
</style>
