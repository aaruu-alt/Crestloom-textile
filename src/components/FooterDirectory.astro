---
import brand from '../assets/home/footer-brand.svg';
import CopyrightYear from './CopyrightYear.astro';
import { routes } from '../lib/routes';
const columns = [
  { title: 'Rugs & flooring', links: ['Rugs', 'Bathmats'] },
  { title: 'Soft furnishings', links: ['Cushions', 'Cushion covers', 'Throws', 'Poufs'] },
  { title: 'Bath, kitchen & table', links: ['Terry towels', 'Table cloth', 'Shower curtains', 'Table covers'] },
  { title: 'Storage & décor', links: ['Baskets', 'Wall hangings', 'Wall art', 'Halloween collection'] },
];
const categorySlug = (label: string) => ({ 'Table cloth': 'table-covers', 'Table covers': 'table-covers' }[label] ?? label.toLowerCase().replaceAll(' ', '-'));
const site = [{ label: 'About', href: routes.about }, { label: 'Sourcing', href: routes.sourcing }, { label: 'Contact', href: routes.contact }, { label: 'Privacy', href: routes.privacy }];
---
<footer class="directory-footer padding-global">
  <div class="container-large directory-footer_inner">
    <div class="directory-footer_top">
      <a href={routes.home} aria-label="Crestloom Textile — home" class="directory-footer_brand"><img src={brand.src} alt="Crestloom Textile" width="336" height="57" /></a>
      <div class="directory-footer_email"><p>Sourcing enquiries</p><a href="mailto:info@crestloom.in">info@crestloom.in</a></div>
    </div>
    <div class="directory-footer_rule"></div>
    <div class="directory-footer_body">
      <p class="directory-footer_intro">GLOBAL SOURCING<br />FOR HOME TEXTILES</p>
      <nav class="directory-footer_columns" aria-label="Footer directory">
        {columns.map(column => <div class="directory-footer_column"><h2>{column.title}</h2><ul>{column.links.map(label => <li><a href={`${routes.collections}?category=${categorySlug(label)}`} class="text-link">{label}</a></li>)}</ul></div>)}
        <div class="directory-footer_column"><h2>Site index</h2><ul>{site.map(link => <li><a href={link.href} class="text-link">{link.label}</a></li>)}</ul></div>
      </nav>
    </div>
    <div class="directory-footer_bottom">
      <div class="directory-footer_rule"></div>
      <div class="directory-footer_meta"><p class="directory-footer_place">Panipat <span aria-hidden="true">·</span> India</p><p>© <CopyrightYear /> Crestloom Textile · All rights reserved</p></div>
    </div>
  </div>
</footer>
<style>
  .directory-footer { padding-block: 3rem 1.25rem; background: var(--color--cyan-blue); color: var(--color--offwhite); }
  .directory-footer_inner { display: flex; flex-direction: column; gap: 1.875rem; }
  .directory-footer_top { display: flex; justify-content: space-between; min-height: 5.75rem; gap: 2rem; }
  .directory-footer_brand { width: 21.007rem; flex-shrink: 0; }
  .directory-footer_email { display: flex; flex-direction: column; gap: .5rem; }
  .directory-footer_email p, .directory-footer_column h2, .directory-footer_place { font: 500 .75rem/120% var(--font--accent); letter-spacing: .18em; text-transform: uppercase; color: var(--color--sandy-gold); }
  .directory-footer_email a { font: 500 1.75rem/100% var(--font--heading); letter-spacing: .01em; }
  .directory-footer_rule { height: 1px; background: var(--color--offwhite); opacity: .45; }
  .directory-footer_body { display: flex; justify-content: space-between; gap: 1rem; }
  .directory-footer_intro { font: 500 1.5rem/110% var(--font--heading); letter-spacing: .01em; flex: 0 0 15.3125rem; }
  .directory-footer_columns { display: grid; grid-template-columns: 9.0625rem 10.9375rem 13.375rem 11.625rem 7.5rem; gap: 2.5rem; }
  .directory-footer_column { display: flex; flex-direction: column; gap: 2rem; }
  .directory-footer_column ul { display: flex; flex-direction: column; gap: .625rem; font: 400 .875rem/135% var(--font--accent); letter-spacing: .06em; text-transform: uppercase; }
  .directory-footer_bottom { display: flex; flex-direction: column; gap: 1.875rem; padding-top: 2rem; }
  .directory-footer_meta { display: flex; justify-content: space-between; gap: 2rem; font: 400 .75rem/120% var(--font--accent); letter-spacing: 0; text-transform: uppercase; }
  .directory-footer_place { display: flex; gap: .5rem; }
  @media (max-width: 991px) {
    .directory-footer { padding-block: 3rem 1.5rem; }
    .directory-footer_inner { gap: 1.75rem; }
    .directory-footer_body { flex-direction: column; gap: 3rem; }
    .directory-footer_intro { flex: auto; }
    .directory-footer_columns { grid-template-columns: 1fr 1fr 1.12fr; gap: 1.75rem 2rem; }
    .directory-footer_column { gap: 1.5rem; }
    .directory-footer_bottom { padding-top: 1.25rem; gap: 1.75rem; }
  }
  @media (max-width: 767px) {
    .directory-footer { padding-block: 2.25rem 1.5rem; }
    .directory-footer_inner { gap: 1.5rem; }
    .directory-footer_top { flex-direction: column; gap: 1.75rem; min-height: 9.5625rem; }
    .directory-footer_brand { width: 100%; max-width: 21.4375rem; }
    .directory-footer_body { gap: 1.75rem; }
    .directory-footer_columns { grid-template-columns: 1fr 1fr; gap: 1.75rem 1rem; }
    .directory-footer_column { gap: 1.125rem; }
    .directory-footer_column h2 { font-size: .6875rem; }
    .directory-footer_column ul { font-size: .75rem; }
    .directory-footer_bottom { padding-top: .75rem; gap: 1.5rem; }
    .directory-footer_meta { flex-direction: column; gap: 1rem; font-size: .625rem; }
  }
</style>
