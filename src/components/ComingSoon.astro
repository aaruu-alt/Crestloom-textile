---
import { Image } from 'astro:assets';
import bg from '../assets/coming-soon-bg.png';
---

<section class="coming-soon">
  <Image
    src={bg}
    alt=""
    class="coming-soon_bg"
    widths={[800, 1200, 1670]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <div class="coming-soon_content">
    <a href="/" class="coming-soon_logo" aria-label="Crestlooms Textile">
      <span class="coming-soon_logo-name">CRESTLOOMS</span>
      <span class="coming-soon_logo-sub">TEXTILE</span>
      <span class="coming-soon_logo-categories">
        <span>Rugs</span>
        <span class="coming-soon_dot"></span>
        <span>Living</span>
        <span class="coming-soon_dot"></span>
        <span>Linen</span>
      </span>
    </a>

    <h1 class="coming-soon_heading">Connecting you to better textile</h1>

    <div class="coming-soon_divider"></div>

    <div class="coming-soon_body">
      <p class="coming-soon_text">
        Rugs, carpets, throws, cushions, bed, bath and table linen. Made in India for brands and retailers worldwide.
      </p>
      <div class="coming-soon_inquiries">
        <p class="coming-soon_label">Inquiries</p>
        <a href="mailto:info@crestloom.in" class="coming-soon_email">
          info@crestloom.in <span class="coming-soon_arrow">→</span>
        </a>
      </div>
    </div>

    <nav class="coming-soon_regions" aria-label="Regions served">
      <span>Europe</span>
      <span class="coming-soon_slash">/</span>
      <span>USA</span>
      <span class="coming-soon_slash">/</span>
      <span>Japan</span>
      <span class="coming-soon_slash">/</span>
      <span>Worldwide</span>
    </nav>
  </div>
</section>

<style>
  /* Figma frame 1440 × 800. Content column starts at x=206 (55 + 151). */
  .coming-soon {
    position: relative;
    min-height: 100svh;
    display: flex;
    background-color: #f3ede3;   /* fallback while image loads */
    overflow: clip;
  }

  .coming-soon_bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .coming-soon_content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 40.25rem;              /* 206 padding + 438 content */
    padding: 7.875rem 0 7.875rem 12.875rem;   /* 126 top, 206 left */
  }

  /* --- Logo lockup --- */
  .coming-soon_logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;                    /* 10 */
    color: var(--color--navy-blue);
  }
  .coming-soon_logo-name {
    font-family: var(--font--heading);
    font-weight: 500;
    font-size: 1.875rem;              /* 30 */
    line-height: 100%;
    letter-spacing: 0.16em;           /* 4.8px */
  }
  .coming-soon_logo-sub {
    font-family: var(--font--accent);
    font-weight: 400;
    font-size: 0.75rem;               /* 12 */
    line-height: 100%;
    letter-spacing: 0.45em;           /* 5.4px */
    color: var(--color--gold);
    padding-left: 0.45em;             /* visually recentre — trailing tracking */
  }
  .coming-soon_logo-categories {
    display: flex;
    align-items: center;
    gap: 0.625rem;                    /* 10 */
    font-family: var(--font--accent);
    font-weight: 400;
    font-size: 0.625rem;              /* 10 */
    line-height: 146%;
    letter-spacing: 0.18em;           /* 1.8px */
    text-transform: uppercase;
    color: var(--color--cyan-blue);
    padding-left: 0.18em;
  }
  .coming-soon_dot {
    width: 0.1875rem;                 /* 3 */
    height: 0.1875rem;
    border-radius: 50%;
    background-color: var(--color--cyan-blue);
  }

  /* --- Heading --- */
  .coming-soon_heading {
    margin-top: 2.125rem;             /* 34 */
    max-width: 19.5625rem;            /* 313 */
    font-family: var(--font--heading);
    font-style: italic;
    font-weight: 500;
    font-size: 3.375rem;              /* 54 */
    line-height: 112%;
    letter-spacing: -0.01em;
    color: var(--color--navy-blue);
  }

  .coming-soon_divider {
    margin-top: 1.625rem;             /* 26 */
    width: 2.625rem;                  /* 42 */
    height: 1px;
    background-color: var(--color--sandy-brown);
  }

  /* --- Body --- */
  .coming-soon_body {
    margin-top: 1.5rem;               /* 24 */
    display: flex;
    flex-direction: column;
    gap: 2.5rem;                      /* 40 */
  }
  .coming-soon_text {
    max-width: 25.5rem;               /* 408 */
    font-family: var(--font--body);
    font-size: 1rem;
    line-height: 150%;
    letter-spacing: -0.01em;
    color: rgb(40 40 42 / 0.8);
  }
  .coming-soon_inquiries {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;                     /* 12 */
  }
  .coming-soon_label {
    font-family: var(--font--accent);
    font-weight: 400;
    font-size: 0.625rem;              /* 10 */
    line-height: 146%;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color--navy-blue);
  }
  .coming-soon_email {
    font-family: var(--font--accent);
    font-weight: 500;
    font-size: 0.875rem;              /* 14 */
    line-height: 100%;
    letter-spacing: 0.02em;
    color: var(--color--cyan-blue);
  }
  .coming-soon_arrow { color: var(--color--sandy-brown); }

  /* --- Regions --- */
  .coming-soon_regions {
    margin-top: 4.125rem;             /* 66 */
    display: flex;
    align-items: center;
    gap: 0.75rem;                     /* 12 */
    font-family: var(--font--accent);
    font-weight: 400;
    font-size: 0.75rem;               /* 12 */
    line-height: 100%;
    letter-spacing: 0.1em;
    color: var(--color--navy-blue);
  }
  .coming-soon_slash { color: var(--color--sandy-brown); }

  /* --- Responsive --- */
  @media (max-width: 991px) {
    .coming-soon_content {
      padding: 5rem 2.5rem 5rem 2.5rem;
      max-width: none;
    }
  }
  @media (max-width: 767px) {
    .coming-soon_content {
      padding: 4rem 1.25rem 3rem;
      justify-content: flex-end;
    }
    .coming-soon_heading { font-size: 2.75rem; }
    .coming-soon_regions { margin-top: 3rem; flex-wrap: wrap; row-gap: 0.5rem; }
  }
</style>
