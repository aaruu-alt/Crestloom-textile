---
import { Image } from 'astro:assets';
import bg from '../assets/coming-soon-bg.png';
import bg2 from '../assets/coming-soon-bg-2.png';
import bg3 from '../assets/coming-soon-bg-3.png';
import bg4 from '../assets/coming-soon-bg-4.png';
import strip from '../assets/coming-soon-mobile-strip.png';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';

/* The first frame is the LCP image. The other three live in a <template> —
   inert markup that no browser fetches — and are cloned in at >=768px only,
   so a phone never downloads scenes it will never show. (display:none is not
   enough: Chrome loads `loading=lazy` images that aren't rendered.) */
const slides = [bg2, bg3, bg4];
---

<section class="coming-soon">
  <!-- Desktop / tablet: full-bleed photo, cycling through four scenes -->
  <div class="coming-soon_bgs" aria-hidden="true">
    <Image
      src={bg}
      alt=""
      class="coming-soon_bg coming-soon_bg-first"
      widths={[800, 1200, 1670]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <template class="coming-soon_slides">
    {slides.map((src) => (
      <Image
        src={src}
        alt=""
        class="coming-soon_bg"
        widths={[800, 1200, 1670]}
        sizes="100vw"
        loading="eager"
        fetchpriority="low"
      />
    ))}
  </template>

  <!-- Mobile: lifestyle strip above the content -->
  <Image
    src={strip}
    alt=""
    class="coming-soon_strip"
    widths={[480, 800, 1024]}
    sizes="100vw"
    loading="eager"
  />

  <div class="coming-soon_content">
    <Wordmark class="coming-soon_logo-block" />

    <div class="coming-soon_content-block">
      <div class="coming-soon_inner-block">
        <div class="coming-soon_heading-block">
          <h1 class="heading-style-h2 coming-soon_heading">Connecting you to better textiles</h1>
          <div class="coming-soon_divider"></div>
        </div>

        <div class="coming-soon_body-block">
          <p class="text-size-regular coming-soon_text">
            Rugs, carpets, throws, cushions, bed, bath and table linen. Made in India for brands and retailers worldwide.
          </p>
          <div class="coming-soon_enquire-block">
            <p class="text-style-tagline-xs coming-soon_label">Enquiries</p>
            <Button href="mailto:info@crestloom.in" variant="ghost-black" icon={false} class="coming-soon_button">info@crestloom.in</Button>
          </div>
        </div>
      </div>

      <nav class="text-style-tagline-xs coming-soon_region-block" aria-label="Regions served">
        <span>Europe</span>
        <span class="coming-soon_dot"></span>
        <span>USA</span>
        <span class="coming-soon_dot"></span>
        <span>Japan</span>
        <span class="coming-soon_dot"></span>
        <span>Worldwide</span>
      </nav>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------------
     Desktop — Figma 1440 × 800. Content column 438 wide at x = 206.
     Section fills the viewport; content sits slightly above centre
     (grid rows 1fr / auto / 1.6fr ≈ 126 top / 211 bottom at 800 tall).
     ------------------------------------------------------------------ */
  .coming-soon {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto 1.6fr;
    background-color: var(--color--offwhite);
    overflow: clip;
  }

  .coming-soon_bgs {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .coming-soon_bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Only the first frame is visible until the cycle fades the next one in. */
  .coming-soon_bg:not(.coming-soon_bg-first) { opacity: 0; }
  .coming-soon_strip { display: none; }

  .coming-soon_content {
    grid-row: 2;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3.625rem;                    /* 58 */
    width: 27.375rem;                 /* 438 */
    margin-left: 12.875rem;           /* 206 */
  }

  /* --- Logo block (Wordmark component, charcoal + gold defaults) --- */

  /* --- Content block --- */
  .coming-soon_content-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;                      /* 40 */
    width: 100%;
  }
  .coming-soon_inner-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;                        /* 32 */
    width: 100%;
  }
  .coming-soon_heading-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;                      /* 24 */
    width: 24.25rem;                  /* 388 */
    max-width: 100%;
  }
  .coming-soon_heading { color: var(--color--text); }

  .coming-soon_divider {
    width: 2.625rem;                  /* 42 */
    height: 1px;
    background-color: var(--color--sandy-brown);
  }

  .coming-soon_body-block {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;                      /* 40 */
    width: 100%;
  }
  .coming-soon_text {
    max-width: 25.625rem;             /* 410 */
    color: rgb(40 40 42 / 0.8);       /* charcoal @ 80% */
  }

  .coming-soon_enquire-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;                     /* 12 */
  }
  .coming-soon_label { color: var(--color--text); }
  .coming-soon_button {
    text-transform: none;             /* email stays lowercase */
  }

  /* --- Region block --- */
  .coming-soon_region-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;                     /* 12 */
    color: var(--color--text);
  }
  .coming-soon_dot {
    width: 0.1875rem;                 /* 3 */
    height: 0.1875rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  /* ------------------------------------------------------------------
     Load animation — same rack-focus as the site heroes (scale + blur),
     copy fades up after it. CSS owns the start state, GSAP owns the motion.
     ------------------------------------------------------------------ */
  :global(html.js) .coming-soon_bg-first {
    transform: scale(1.06);
    filter: blur(5px);
    will-change: transform, filter;
  }
  :global(html.js) .coming-soon.is-loaded .coming-soon_bg-first {
    transform: none;
    filter: none;
    will-change: auto;
  }
  :global(html.js) .coming-soon_content > :global(.coming-soon_logo-block),
  :global(html.js) .coming-soon_heading-block,
  :global(html.js) .coming-soon_body-block,
  :global(html.js) .coming-soon_region-block {
    opacity: 0;
    transform: translateY(1rem);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .coming-soon_bg-first { transform: none; filter: none; }
    :global(html.js) .coming-soon_content > :global(.coming-soon_logo-block),
    :global(html.js) .coming-soon_heading-block,
    :global(html.js) .coming-soon_body-block,
    :global(html.js) .coming-soon_region-block { opacity: 1; transform: none; }
  }

  /* ------------------------------------------------------------------
     Tablet — Figma 1024 × 768. Content at x = 40, y = 52; region row
     pushed to the bottom. Photo cropped further right.
     ------------------------------------------------------------------ */
  @media (max-width: 991px) {
    .coming-soon {
      display: flex;                    /* children stretch to the padding box */
      padding: 6.25rem 2.5rem 3.25rem;  /* 100 / 40 / 52 */
    }
    /* Crop picked on /crop — works across all four scenes. */
    .coming-soon_bg { object-position: 35% center; }

    .coming-soon_content {
      width: 27.375rem;               /* 438 */
      max-width: 100%;
      gap: 4.25rem;                   /* 68 — puts the heading at y 226 as in the frame */
      margin-left: 0;
    }
    .coming-soon_content-block {
      flex: 1;
      justify-content: space-between; /* region row → bottom */
    }
    .coming-soon_text { max-width: 20.125rem; }   /* 322 */
  }

  /* ------------------------------------------------------------------
     Mobile — Figma 390. Offwhite page, 136-tall photo strip on top,
     logo centred, H3 heading, region row at the bottom.
     ------------------------------------------------------------------ */
  @media (max-width: 767px) {
    .coming-soon {
      flex-direction: column;
      align-items: stretch;
      padding: 0;
    }
    .coming-soon_bgs { display: none; }
    .coming-soon_strip {
      display: block;
      width: 100%;
      height: 8.5rem;                 /* 136 */
      object-fit: cover;
      object-position: center;
    }

    .coming-soon_content {
      width: 100%;
      gap: 2rem;                      /* 32 */
      padding: 2.25rem 1rem 1.25rem;  /* 36 / 16 / 20 */
    }
    .coming-soon_content > :global(.coming-soon_logo-block) { align-self: center; }
    .coming-soon_heading-block { width: 100%; }
    .coming-soon_heading {
      font-size: 2.5rem;              /* 40 — H3 */
      line-height: 110%;
    }
    .coming-soon_text { max-width: none; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const HOLD = 10;       // seconds each scene is held
  const CROSSFADE = 2;   // seconds to dissolve into the next one
  const FADE_EASE = 'sine.inOut';   // symmetric — a dissolve shouldn't accelerate like motion does

  const section = document.querySelector<HTMLElement>('.coming-soon');
  if (section && !reducedMotion) {
    const first = section.querySelector('.coming-soon_bg-first');
    const copy = [
      section.querySelector('.coming-soon_logo-block'),
      section.querySelector('.coming-soon_heading-block'),
      section.querySelector('.coming-soon_body-block'),
      section.querySelector('.coming-soon_region-block'),
    ].filter(Boolean);

    // --- Load: rack-focus on the photo, copy rises after it ---
    // A full-screen blur is cheap on a GPU and brutal without one. Skip it on
    // machines that report few cores, and drop it mid-flight if frames start
    // running long — an otherwise-fine laptop under load looks the same to us.
    const fewCores = (navigator.hardwareConcurrency || 8) <= 4;
    let watching = !fewCores;

    const dropBlur = () => {
      watching = false;
      gsap.killTweensOf(first, 'filter');
      gsap.set(first, { filter: 'none' });
    };

    const tl = gsap.timeline({
      delay: 0.15,
      onComplete: () => {
        watching = false;
        section.classList.add('is-loaded');
        gsap.set(first, { clearProps: 'transform,filter,willChange' });
      },
    });
    tl.to(first, { scale: 1, duration: 2.4 }, 0);
    if (fewCores) gsap.set(first, { filter: 'none' });
    else tl.to(first, { filter: 'blur(0px)', duration: 1.4 }, 0);
    tl.to(copy, { y: 0, opacity: 1, duration: 1, stagger: 0.12 }, 0.35);

    if (watching) {
      const BUDGET = 32;   // ms — two missed frames at 60Hz
      let long = 0;
      let last = performance.now();
      const watch = () => {
        if (!watching) return;
        const now = performance.now();
        long = now - last > BUDGET ? long + 1 : 0;
        last = now;
        if (long >= 6) dropBlur();          // sustained, not a one-off hitch
        else requestAnimationFrame(watch);
      };
      requestAnimationFrame(watch);
    }

    // --- Cycle the scenes (desktop/tablet only — a phone keeps one photo) ---
    const bgs = section.querySelector<HTMLElement>('.coming-soon_bgs')!;
    const template = section.querySelector<HTMLTemplateElement>('.coming-soon_slides');
    const wide = matchMedia('(min-width: 768px)');

    const start = () => {
      if (!template || !template.isConnected) return;
      bgs.append(template.content.cloneNode(true));   // only now do the extra photos load
      template.remove();

      const slides = [...bgs.querySelectorAll<HTMLElement>('.coming-soon_bg')];
      let i = 0;
      let layer = 1;   // always stack the incoming scene on top, including on the wrap to the first
      const advance = () => {
        if (!wide.matches) return;                        // resized down — hold on the current scene
        const from = slides[i];
        const to = slides[(i + 1) % slides.length];
        if (!(to as HTMLImageElement).complete) return;   // not decoded yet — try again next beat
        i = (i + 1) % slides.length;
        gsap.set(to, { zIndex: ++layer });
        gsap.to(to, {
          opacity: 1,
          duration: CROSSFADE,
          ease: FADE_EASE,
          onComplete: () => gsap.set(from, { opacity: 0 }),
        });
      };
      gsap.delayedCall(HOLD + 2.4, function cycle() {
        advance();
        gsap.delayedCall(HOLD + CROSSFADE, cycle);
      });
    };

    if (wide.matches) start();
    else wide.addEventListener('change', (e) => e.matches && start());
  }
</script>
