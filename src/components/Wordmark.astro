---
/**
 * Wordmark — "CRESTLOOM / TEXTILE" lockup as an inline vector
 * (Figma "Brand / Wordmark" 103:9, flattened; 260 × 58 box).
 * Colours come from CSS vars so each context can theme it:
 *   --wordmark-color   (CRESTLOOM)  default: --color--text
 *   --wordmark-accent  (TEXTILE)    default: --color--gold
 */
import svg from '../assets/wordmark.svg?raw';

interface Props {
  href?: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['wordmark', className]} role="img" aria-label="Crestloom Textile" set:html={svg} />

<style>
  .wordmark {
    display: inline-block;
    width: 16.25rem;                  /* 260 */
    height: 3.625rem;                 /* 58 */
    color: var(--wordmark-color, var(--color--text));
  }
  .wordmark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .wordmark :global(.wordmark_name) { fill: currentColor; }
  .wordmark :global(.wordmark_sub)  { fill: var(--wordmark-accent, var(--color--gold)); }
</style>
