---
import Lines from './Lines.astro';
import Button from './Button.astro';
import { routes } from '../lib/routes';
import textile from '../assets/home/origin.png';
import desktopTextile from '../assets/home/origin-desktop.png';
import { Image, getImage } from 'astro:assets';
const desktopImage = await getImage({ src: desktopTextile, width: 1920, format: 'webp' });
---
<section class="origin" id="about" data-reveal-section>
  <picture class="origin_image">
    <source media="(min-width: 992px)" srcset={desktopImage.src} />
    <Image src={textile} alt="Natural woven textiles, yarn and folded fabrics" widths={[375, 750, 1147]} sizes="100vw" loading="lazy" />
  </picture>
  <div class="origin_overlay" aria-hidden="true"></div>
  <div class="origin_content padding-global">
    <div class="container-large origin_inner">
      <div class="origin_copy" data-reveal-group>
        <Lines tag="h2" class="heading-style-h2 origin_heading" lines={['Crafted in India, with purpose.']} />
        <p class="text-size-large origin_intro" data-reveal="fade">Crestloom was built to make sourcing easier and reliable for international clients. Looking for a dependable sourcing partner in India click the link tell us what you’re looking for?</p>
        <Button href={routes.contact} variant="filled-gold" data-reveal>Start a conversation</Button>
      </div>
    </div>
  </div>
</section>
<style>
  .origin { position: relative; height: 42.8125rem; background: var(--color--charcoal-black); color: var(--color--offwhite); overflow: clip; }
  .origin > :global(.origin_image) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .origin_image img { width: 100%; height: 100%; object-fit: cover; }
  .origin_overlay { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 30%, rgb(0 0 0 / .7) 100%); }
  .origin_content { position: relative; z-index: 1; height: 100%; display: flex; align-items: center; }
  .origin_inner { display: flex; justify-content: flex-end; }
  .origin_copy { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; width: 25rem; }
  .origin_heading { color: var(--color--offwhite); }
  .origin_intro { opacity: .86; }
  .origin_copy > :global(.button) { margin-top: 1rem; }
</style>
