---
/**
 * BlurImage — Astro <Image> with a blur-up placeholder.
 * A ~20px version of the image is rendered at build (sharp), inlined as a
 * base64 background; the real image fades in on load. Compositor-only.
 * Works for remote (CMS) images too, since the placeholder is made at build.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import sharp from 'sharp';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const { src, alt, class: className, widths, sizes, loading = 'lazy', fetchpriority } = Astro.props;

// Tiny placeholder: 20px wide WebP, base64 (made at build; cached per source)
const cache = ((globalThis as any).__blurCache ??= new Map<string, string>()) as Map<string, string>;
let placeholder = '';
const fsPath = (src as ImageMetadata & { fsPath?: string }).fsPath;
if (fsPath) {
  placeholder = cache.get(fsPath) ?? '';
  if (!placeholder) {
    try {
      const buf = await sharp(fsPath).resize(20).webp({ quality: 40 }).toBuffer();
      placeholder = `data:image/webp;base64,${buf.toString('base64')}`;
      cache.set(fsPath, placeholder);
    } catch { /* no placeholder — image still loads normally */ }
  }
}
---

<span class:list={['blur-image', className]} style={placeholder ? `background-image:url(${placeholder})` : undefined}>
  <Image
    src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority}
    class="blur-image_img"
    onload="this.parentElement.classList.add('is-loaded')"
  />
</span>

<style>
  .blur-image {
    display: block;
    position: relative;
    overflow: clip;
    background-size: cover;
    background-position: center;
  }
  .blur-image_img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease--apple);
  }
  .blur-image.is-loaded .blur-image_img { opacity: 1; }
  /* No JS / already cached: don't hide the image */
  :global(html:not(.js)) .blur-image_img { opacity: 1; }
</style>
