---
/**
 * SmallScreenNotice — Figma "Mobile and tablet wait" (284:141).
 * Temporary: shown below 992px until the tablet/mobile layouts exist.
 * Wrap the page content in `.desktop-only` and place this beside it.
 */
import Wordmark from './Wordmark.astro';
---

<div class="small-screen-notice">
  <Wordmark class="small-screen-notice_brand" />
  <div class="small-screen-notice_copy">
    <h1 class="heading-style-h3">Coming soon to <span class="small-screen-notice_device"></span></h1>
    <p class="text-size-regular">In the mean time check our website on a desktop or laptop</p>
  </div>
</div>

<style>
  .small-screen-notice {
    display: none;
    min-height: 100svh;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;                      /* 24 */
    padding: 9.5625rem 1.25rem 4rem;  /* 153 top */
    background-color: var(--color--offwhite);
    color: var(--color--text);
    text-align: center;
  }
  .small-screen-notice_copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;                      /* 8 */
  }
  .small-screen-notice_copy p { max-width: 17.25rem; }   /* 276 */

  /* Device word set in CSS so it's correct before any JS */
  .small-screen-notice_device::before { content: 'tablet'; }
  @media (max-width: 767px) {
    .small-screen-notice_device::before { content: 'mobile'; }
  }

  @media (max-width: 991px) {
    .small-screen-notice { display: flex; }
    :global(.desktop-only) { display: none !important; }
  }
</style>
