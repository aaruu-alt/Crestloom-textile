---
import Lines from './Lines.astro';
const steps = [
  'Understanding your request',
  'Choosing the right manufacturing partner',
  'Sampling & product development',
  'Quotation & order confirmation',
  'Product monitoring & inspection',
  'Packing & shipping',
];
---
<section class="sourcing padding-global padding-section-large" id="sourcing" data-reveal-section>
  <div class="container-large sourcing_inner" id="process">
    <div class="sourcing_copy" data-reveal-group>
      <div class="sourcing_heading-block">
        <Lines class="text-style-tagline text-color-sandy-gold" lines={['Our process']} />
        <Lines tag="h2" class="heading-style-h2" lines={['How we work together']} />
      </div>
      <p class="text-size-large sourcing_intro" data-reveal="fade">We take your ideas and requirements through to a finished product, coordinating every thing from quality expectations to final destination.</p>
    </div>
    <ol class="sourcing_steps" data-reveal-group>
      {steps.map((title, i) => <li class="sourcing_step" data-reveal>
        <span class="text-style-tagline text-color-sandy-gold sourcing_step-number">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="heading-style-h4 sourcing_step-title">{title}</h3>
      </li>)}
    </ol>
  </div>
</section>
<style>
  .sourcing { background: var(--color--cyan-blue); color: var(--color--offwhite); }
  .sourcing_inner { display: flex; justify-content: space-between; gap: 2rem; }
  .sourcing_copy { width: 32.5rem; display: flex; flex-direction: column; gap: 2rem; }
  .sourcing_heading-block { display: flex; flex-direction: column; gap: .75rem; }
  .sourcing_intro { max-width: 29.5rem; opacity: .8; }
  .sourcing_steps { width: 42.5rem; display: flex; flex-direction: column; gap: 3rem; }
  .sourcing_step { display: flex; gap: 2rem; padding-top: 3rem; border-top: 1px solid rgb(246 245 242 / .7); }
  .sourcing_step-number { padding-top: .5rem; flex-shrink: 0; }
  .sourcing_step-title { text-transform: uppercase; }
  .sourcing_step:nth-child(2) .sourcing_step-title { max-width: 31.6875rem; }
</style>
