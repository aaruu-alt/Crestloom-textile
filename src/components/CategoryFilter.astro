---
/**
 * CategoryFilter — Figma "Collection Page / Category Filter" (140:209).
 * Fixed to the viewport bottom while the grid is on screen. Switches the
 * rendered grid state and mirrors the choice in ?category=.
 */
import { categories } from '../data/collection';
const options = [{ slug: 'all', name: 'All' }, ...categories];
---

<nav class="category-filter" aria-label="Filter by category">
  <span class="category-filter_active" aria-hidden="true"></span>
  {options.map((o, i) => (
    <button type="button" class="text-style-button category-filter_option" data-category={o.slug} aria-pressed={i === 0 ? 'true' : 'false'}>
      {o.name}
    </button>
  ))}
</nav>

<script>
  import { gsap, ScrollTrigger } from '../scripts/motion';
  import { revealNow } from '../scripts/reveal';

  const bar = document.querySelector<HTMLElement>('.category-filter');
  const grid = document.getElementById('collection-grid');
  if (bar && grid) {
    const options = [...bar.querySelectorAll<HTMLButtonElement>('.category-filter_option')];
    const active = bar.querySelector<HTMLElement>('.category-filter_active')!;
    const states = [...grid.querySelectorAll<HTMLElement>('.collection-grid_state')];
    const nav = document.querySelector<HTMLElement>('.navbar');
    let busy = false;

    // --- Active indicator follows the selected option ---
    const moveIndicator = (btn: HTMLElement, instant = false) => {
      const x = btn.offsetLeft;
      const w = btn.offsetWidth;
      instant ? gsap.set(active, { x, width: w }) : gsap.to(active, { x, width: w, duration: 0.6 });
    };
    const setPressed = (btn: HTMLElement) => options.forEach((o) => o.setAttribute('aria-pressed', String(o === btn)));
    const syncUrl = (slug: string) => {
      const url = new URL(location.href);
      slug === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', slug);
      history.replaceState(null, '', url);
    };

    // --- Pinch transition between grid states ---
    const switchTo = (slug: string) => {
      const btn = options.find((o) => o.dataset.category === slug) ?? options[0];
      slug = btn.dataset.category!;
      const from = states.find((s) => !s.hidden)!;
      const to = states.find((s) => s.dataset.category === slug)!;
      if (busy || from === to) return;
      busy = true;
      setPressed(btn);
      moveIndicator(btn);
      syncUrl(slug);

      const zoomIn = slug !== 'all';                 // category = zoom in, All = zoom out
      const origin = '50% 0%';
      gsap.timeline({ onComplete: () => (busy = false) })
        .to(from, { opacity: 0, scale: zoomIn ? 1.04 : 0.96, transformOrigin: origin, duration: 0.4 })
        .add(() => {
          from.hidden = true;
          to.hidden = false;
          revealNow(to);                            // incoming cards are simply there
          gsap.set(to, { opacity: 0, scale: zoomIn ? 0.96 : 1.04, transformOrigin: origin });
          // keep the top of the grid in view while it's invisible
          const top = grid.getBoundingClientRect().top + scrollY - (nav?.offsetHeight ?? 0) - 40;
          if (grid.getBoundingClientRect().top < 0) window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
          ScrollTrigger.refresh();
        })
        .to(to, { opacity: 1, scale: 1, duration: 0.8 })
        .set([from, to], { clearProps: 'transform,opacity' });
    };

    options.forEach((o) => o.addEventListener('click', () => switchTo(o.dataset.category!)));

    // Initial state from the URL (no transition)
    {
      const slug = new URLSearchParams(location.search).get('category') ?? 'all';
      const btn = options.find((o) => o.dataset.category === slug) ?? options[0];
      setPressed(btn);
      moveIndicator(btn, true);
      states.forEach((s) => (s.hidden = s.dataset.category !== btn.dataset.category));
    }
    window.addEventListener('resize', () => moveIndicator(options.find((o) => o.getAttribute('aria-pressed') === 'true')!, true));

    // --- Show only while the grid is on screen; first appearance waits for the cards ---
    gsap.set(bar, { y: 24, opacity: 0 });
    let first = true;
    ScrollTrigger.create({
      trigger: grid,
      start: 'top bottom-=120',
      end: 'bottom bottom-=120',
      onToggle: (self) => {
        gsap.to(bar, { y: self.isActive ? 0 : 24, opacity: self.isActive ? 1 : 0, duration: 0.6, delay: first && self.isActive ? 1.2 : 0 });
        first = false;
      },
    });

    // --- Infinite grid: reveal the next batch of 14 as the sentinel approaches ---
    const sentinel = grid.querySelector('.collection-grid_sentinel');
    const batches = [...grid.querySelectorAll<HTMLElement>('.collection-grid_batch')];
    if (sentinel && batches.length > 1) {
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        const next = batches.find((b) => b.hidden);
        if (next) { next.hidden = false; ScrollTrigger.refresh(); }
        else io.disconnect();
      }, { rootMargin: '600px 0px' });
      io.observe(sentinel);
    }
  }
</script>

<style>
  .category-filter {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.5rem;                      /* 24 */
    padding: 0.5rem;                  /* 8 */
    border-radius: 2px;
    background-color: var(--color--cyan-blue);
    transform: translateX(-50%);
  }
  .category-filter_active {
    position: absolute;
    top: 0.5rem;
    left: 0;
    height: calc(100% - 1rem);
    width: 5.75rem;
    background-color: var(--color--offwhite);
  }
  .category-filter_option {
    position: relative;
    width: 5.75rem;                   /* 92 */
    padding: 1rem 0.875rem;           /* 16 / 14 */
    color: var(--color--offwhite);
    transition: color 500ms var(--ease--apple);
  }
  .category-filter_option[aria-pressed='true'] { color: var(--color--charcoal-black); }
</style>
