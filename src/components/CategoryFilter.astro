---
import { categories, categoryGroups } from '../data/collection';
import chevron from '../assets/catalog-filter-chevron.svg';
---
<div class="category-filter" id="collection-filter">
  <div class="category-filter_controls">
    <button type="button" class="category-filter_all text-style-button" aria-pressed="true">All collections</button>
    <button type="button" class="category-filter_toggle text-style-button" aria-expanded="false" aria-controls="category-picker">Category <span class="category-filter_chevron" style={`--chevron: url("${chevron.src}")`} aria-hidden="true"></span></button>
  </div>
  <p class="category-filter_selected text-style-button" aria-live="polite">All collections</p>
  <dialog class="category-picker" id="category-picker" aria-labelledby="category-picker-title">
    <div class="category-picker_header">
      <p id="category-picker-title">Browse <span class="category-picker_desktop-title">by category</span><span class="category-picker_mobile-title">categories</span></p>
      <button type="button" class="category-picker_close" aria-label="Close categories">×</button>
    </div>
    <div class="category-picker_groups">
      {categoryGroups.map(group => <section class="category-picker_group">
        <h2>{group.name}</h2>
        <div class="category-picker_options">{group.slugs.map(slug => {
          const category = categories.find(c => c.slug === slug)!;
          return <button type="button" class="category-picker_option" data-category={slug} aria-pressed="false">{category.name}</button>;
        })}</div>
      </section>)}
    </div>
  </dialog>
</div>
<script>
  import { gsap, reducedMotion, ScrollTrigger } from '../scripts/motion';
  const filter = document.querySelector<HTMLElement>('.category-filter');
  const picker = document.querySelector<HTMLDialogElement>('.category-picker');
  const grid = document.getElementById('collection-grid');
  if (filter && picker && grid) {
    const toggle = filter.querySelector<HTMLButtonElement>('.category-filter_toggle')!;
    const all = filter.querySelector<HTMLButtonElement>('.category-filter_all')!;
    const selected = filter.querySelector<HTMLElement>('.category-filter_selected')!;
    const options = [...picker.querySelectorAll<HTMLButtonElement>('[data-category]')];
    const cards = [...grid.querySelectorAll<HTMLButtonElement>('.product-card')];
    const initialGridNodes = [...grid.childNodes];
    const cushionHeading = grid.querySelector<HTMLElement>('[data-cushion-heading="cushions"]')!;
    const coverHeading = grid.querySelector<HTMLElement>('[data-cushion-heading="covers"]')!;
    let activeCategory = 'all';
    let opener: HTMLElement | null = null;
    let previousOverflow = '';
    let transition: gsap.core.Timeline | undefined;
    let closeTween: gsap.core.Tween | undefined;
    const position = () => {
      const rect = filter.getBoundingClientRect();
      picker.style.setProperty('--filter-top', `${Math.max(16, Math.min(rect.bottom + 16, innerHeight - 320))}px`);
      picker.style.setProperty('--filter-left', `${rect.left}px`);
    };
    const open = () => {
      closeTween?.kill(); position(); opener = toggle;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      picker.showModal(); toggle.setAttribute('aria-expanded', 'true');
      gsap.fromTo(picker, { opacity: 0, y: -12, '--backdrop-opacity': 0 }, { opacity: 1, y: 0, '--backdrop-opacity': 1, duration: reducedMotion ? 0 : 1, ease: 'apple' });
    };
    const close = () => {
      if (!picker.open) return;
      closeTween = gsap.to(picker, { opacity: 0, y: -8, '--backdrop-opacity': 0, duration: reducedMotion ? 0 : .8, ease: 'apple', overwrite: true, onComplete: () => {
        picker.close(); toggle.setAttribute('aria-expanded', 'false'); document.body.style.overflow = previousOverflow; opener?.focus({ preventScroll: true });
      }});
    };
    const apply = (requested: string, animate = true, updateUrl = true) => {
      const category = requested === 'cushion-covers' ? 'cushions' : requested;
      const option = options.find(o => o.dataset.category === category);
      const slug = option?.dataset.category ?? 'all';
      const swap = () => {
        activeCategory = slug;
        grid.classList.toggle('is-filtered', slug !== 'all');
        grid.classList.toggle('is-cushions', slug === 'cushions');
        cushionHeading.hidden = coverHeading.hidden = slug !== 'cushions';
        if (slug === 'cushions') {
          const byCode = (a: HTMLButtonElement, b: HTMLButtonElement) => a.dataset.product!.localeCompare(b.dataset.product!);
          grid.append(cushionHeading, ...cards.filter(c => c.dataset.product?.startsWith('CL-CU-')).sort(byCode), coverHeading, ...cards.filter(c => c.dataset.product?.startsWith('CL-CC-')).sort(byCode));
        } else {
          grid.replaceChildren(...initialGridNodes);
        }
        const focusedCard = cards.find(card => card === document.activeElement);
        cards.forEach(card => {
          card.hidden = slug === 'all' ? card.dataset.overview !== 'true' : card.dataset.category !== slug;
          card.disabled = slug !== 'all';
          if (slug === 'all') card.setAttribute('aria-label', `View all ${card.querySelector('.product-card_caption > span')?.textContent ?? 'products'}`);
          else card.removeAttribute('aria-label');
        });
        if (focusedCard?.disabled) all.focus({ preventScroll: true });
        options.forEach(o => o.setAttribute('aria-pressed', String(o === option)));
        all.setAttribute('aria-pressed', String(slug === 'all'));
        toggle.classList.toggle('has-selection', slug !== 'all');
        selected.textContent = option?.textContent ?? 'All collections';
        selected.hidden = slug === 'cushions';
        if (updateUrl) { const url = new URL(location.href); slug === 'all' ? url.searchParams.delete('category') : url.searchParams.set('category', slug); history.replaceState(null, '', url); }
        ScrollTrigger.refresh();
      };
      transition?.kill();
      if (!animate || reducedMotion) { swap(); gsap.set(grid, { clearProps: 'opacity,transform' }); }
      else {
        const zoomIn = slug !== 'all';
        transition = gsap.timeline()
          .to(grid, { opacity: 0, scale: zoomIn ? 1.04 : .96, transformOrigin: '50% 0%', duration: .4, ease: 'apple' })
          .add(swap)
          .fromTo(grid, { opacity: 0, scale: zoomIn ? .96 : 1.04, transformOrigin: '50% 0%' }, { opacity: 1, scale: 1, duration: 1, ease: 'apple' })
          .set(grid, { clearProps: 'opacity,transform,transformOrigin' });
      }
    };
    toggle.addEventListener('click', () => picker.open ? close() : open());
    picker.querySelector('.category-picker_close')?.addEventListener('click', close);
    picker.addEventListener('cancel', e => { e.preventDefault(); close(); });
    picker.addEventListener('click', e => { const r = picker.getBoundingClientRect(); if (e.target === picker && (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom)) close(); });
    options.forEach(o => o.addEventListener('click', () => { apply(o.dataset.category!); close(); }));
    cards.forEach(card => card.addEventListener('click', () => { if (activeCategory === 'all') apply(card.dataset.category!); }));
    all.addEventListener('click', () => { apply('all'); close(); });
    window.addEventListener('resize', () => { if (picker.open) position(); });
    window.addEventListener('popstate', () => apply(new URLSearchParams(location.search).get('category') ?? 'all', false, false));
    apply(new URLSearchParams(location.search).get('category') ?? 'all', false, false);
  }
</script>
<style>
  .category-filter { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .category-filter_controls { display: flex; gap: .75rem; }
  .category-filter_all, .category-filter_toggle { padding: 1rem 1.25rem; border: 1px solid var(--color--cyan-blue); display: inline-flex; align-items: center; justify-content: center; gap: .75rem; }
  .category-filter_all { background: var(--color--cyan-blue); color: var(--color--offwhite); }
  .category-filter_all[aria-pressed='false'] { background: transparent; color: var(--color--text); }
  .category-filter_toggle.has-selection { background: var(--color--cyan-blue); color: var(--color--offwhite); }
  .category-filter_selected { text-transform: uppercase; }
  .category-filter_selected[hidden] { display: none; }
  .category-filter_chevron { display: block; width: .75rem; height: .75rem; flex-shrink: 0; background-color: currentColor; mask: var(--chevron) center / contain no-repeat; -webkit-mask: var(--chevron) center / contain no-repeat; }
  .category-picker { position: fixed; top: var(--filter-top, 10rem); left: var(--filter-left, 3.5rem); margin: 0; padding: 1.75rem 2rem 2rem; width: 70rem; max-width: calc(100vw - 7rem); max-height: calc(100svh - var(--filter-top, 10rem) - 1rem); border: 1px solid rgb(40 40 42 / .14); background: var(--color--offwhite); color: var(--color--text); box-shadow: 0 .75rem 2rem rgb(40 40 42 / .08); }
  .category-picker::backdrop { background: rgb(40 40 42 / .12); opacity: var(--backdrop-opacity, 0); }
  .category-picker_header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; }
  .category-picker_header p, .category-picker_group h2 { font: 500 .75rem/120% var(--font--accent); letter-spacing: .18em; text-transform: uppercase; }
  .category-picker_close { font-size: 1.5rem; line-height: 1; width: 2rem; height: 1.5rem; }
  .category-picker_mobile-title { display: none; }
  .category-picker_groups { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 2rem; }
  .category-picker_group { display: flex; flex-direction: column; gap: 1.5rem; }
  .category-picker_group h2 { color: var(--color--sandy-brown); }
  .category-picker_options { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .category-picker_option { font: 500 .875rem/120% var(--font--accent); letter-spacing: .1em; text-align: left; }
  .category-picker_option[aria-pressed='true'] { color: var(--color--cyan-blue); text-decoration: underline; text-underline-offset: .3rem; }
  @media (max-width: 991px) {
    .category-picker { width: calc(100vw - 5rem); max-width: none; padding: 1.5rem; }
    .category-picker_groups { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .category-picker_group { gap: 1rem; }
    .category-picker_options { gap: 0; }
    .category-picker_option { min-height: 2.75rem; display: flex; align-items: center; }
  }
  @media (max-width: 767px) {
    .category-filter { flex-direction: column; align-items: stretch; gap: .96rem; }
    .category-filter_controls { flex-direction: column; gap: .72rem; }
    .category-filter_all, .category-filter_toggle { width: 100%; padding: .96rem 1.2rem; font-size: .84rem; }
    .category-filter_selected { font-size: .84rem; }
    .category-picker { inset: 0; width: 100vw; height: 100svh; max-width: none; max-height: none; padding: 0; border: 0; box-shadow: none; }
    .category-picker_header { height: 4.56rem; padding-inline: .96rem; margin: 0; position: sticky; top: 0; background: var(--color--offwhite); }
    .category-picker_header p { font-size: .72rem; color: var(--color--sandy-brown); }
    .category-picker_close { width: 2.64rem; height: 2.64rem; }
    .category-picker_mobile-title { display: inline; }
    .category-picker_desktop-title { display: none; }
    .category-picker_groups { grid-template-columns: 1fr; padding: 1.44rem .96rem; gap: 1.92rem; }
    .category-picker_group { gap: .96rem; }
    .category-picker_group h2 { font-size: .72rem; }
    .category-picker_option { font-size: .84rem; min-height: 2.64rem; }
  }
</style>
