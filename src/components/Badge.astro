---
/** Badge — small offwhite label used on imagery ("THROW", "01 / LIVING"). */
interface Props { class?: string; size?: 'sm' | 'md' }
const { class: className, size = 'sm' } = Astro.props;
---
<span class:list={[size === 'md' ? 'text-style-tagline' : 'text-style-tagline-xs', 'badge', className]}><slot /></span>

<style>
  .badge {
    display: inline-block;
    padding: 0.5rem 0.75rem;          /* 8 / 12 */
    background-color: var(--color--offwhite);
    color: var(--color--charcoal-black);
    white-space: nowrap;
  }
</style>
