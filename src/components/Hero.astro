---
/**
 * Hero — Figma "Hero" (121:15), 1440 × 900.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Badge from './Badge.astro';
import heroImage from '../assets/hero-living.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero">
  <Image
    src={heroImage}
    alt="Blue floral throw draped over a linen sofa"
    class="hero_image"
    widths={[800, 1200, 1672]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero_overlay-bottom" aria-hidden="true"></div>
  <div class="hero_overlay-diagonal" aria-hidden="true"></div>

  <div class="hero_content padding-global">
    <div class="hero_copy">
      <p class="text-style-tagline hero_tagline">
        <span>Rugs</span>
        <span class="hero_dot"></span>
        <span>Living</span>
        <span class="hero_dot"></span>
        <span>Linen</span>
      </p>
      <h1 class="heading-style-h1 hero_heading">
        Rooted in craft.<br />
        <em>Ready for what’s next.</em>
      </h1>
      <Button href={`${base}/#collections`} variant="outline">Explore collections</Button>
    </div>

    <Badge class="hero_badge">01 / Living</Badge>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100svh;
    min-height: 40rem;
    background-color: var(--color--charcoal-black);
    color: var(--color--offwhite);
    overflow: clip;
  }

  .hero_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Figma "overlay/bottom" — full-height fade to black */
  .hero_overlay-bottom {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.66) 105.94%
    );
  }
  /* Figma "overlay/diagonal" — darkens the lower-left corner */
  .hero_overlay-diagonal {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      -51.03deg,
      rgb(0 0 0 / 0) 13.27%,
      rgb(0 0 0 / 0) 69.39%,
      rgb(0 0 0 / 0.66) 122.02%
    );
  }

  .hero_content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    padding-bottom: 3rem;             /* 48 */
  }

  .hero_copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;                    /* 18 */
    max-width: 38.125rem;             /* 610 */
  }

  .hero_tagline {
    display: flex;
    align-items: center;
    gap: 0.875rem;                    /* 14 */
    color: var(--color--sandy-gold);
  }
  .hero_dot {
    width: 0.1875rem;                 /* 3 */
    height: 0.1875rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  .hero_heading {
    color: var(--color--offwhite);
  }
  .hero_heading em {
    font-style: italic;
  }

  .hero_content > :global(.hero_badge) { flex-shrink: 0; }

  /* --- Tablet --- */
  @media (max-width: 991px) {
    .hero_heading { font-size: 3.5rem; }   /* 56 */
  }

  /* --- Mobile (no design yet — sensible default) --- */
  @media (max-width: 767px) {
    .hero { min-height: 36rem; }
    .hero_content {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 2rem;
    }
    .hero_heading { font-size: 2.75rem; }  /* 44 */
    .hero_content > :global(.hero_badge) { align-self: flex-end; }
  }
</style>
