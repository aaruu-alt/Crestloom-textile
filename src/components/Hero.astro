---
/**
 * Hero — Figma "Hero" (121:15), 1440 × 900.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Badge from './Badge.astro';
import heroImage from '../assets/home/hero-living.webp';
import bathImage from '../assets/home/hero-bath.webp';
import rugsImage from '../assets/home/hero-rugs.webp';
import { routes } from '../lib/routes';
const slides = [
  { image: heroImage, label: 'Living', alt: 'Floral throw and cushions on a sunlit linen sofa' },
  { image: bathImage, label: 'Bath', alt: 'Coordinated bath textiles in a warm bathroom' },
  { image: rugsImage, label: 'Rugs', alt: 'Woven rug in a sunlit interior' },
];
---

<section class="hero">
  {slides.map((slide, i) => <Image
    src={slide.image} alt={slide.alt}
    class:list={['hero_image', { 'is-active': i === 0 }]}
    data-hero-image={i} aria-hidden={i !== 0 ? 'true' : undefined}
    widths={[750, 1200, 1920]} sizes="100vw"
    loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'}
  />)}
  <div class="hero_overlay-bottom" aria-hidden="true"></div>
  <div class="hero_overlay-diagonal" aria-hidden="true"></div>

  <div class="hero_content padding-global">
    <div class="hero_copy">
      <p class="text-style-tagline hero_tagline hero_mask">
        <span class="hero_mask-inner">
          <span>Rugs</span>
          <span class="hero_dot"></span>
          <span>Living</span>
          <span class="hero_dot"></span>
          <span>Linen</span>
        </span>
      </p>
      <h1 class="heading-style-h1 hero_heading">
        <span class="hero_mask"><span class="hero_mask-inner">Connecting you to</span></span>
        <span class="hero_mask"><span class="hero_mask-inner"><em>better textiles.</em></span></span>
      </h1>
      <Button href={routes.collections} variant="outline" class="hero_button">Explore collections</Button>
    </div>

    <button class="hero_badge" type="button" aria-label="Show next hero image"><Badge><span class="hero_badge-progress" aria-hidden="true"></span><span class="hero_badge-label" data-hero-label>01 / Living</span></Badge></button>
    <div class="hero_controls">
      <div class="hero_pagination" aria-label="Hero images">
        {slides.map((slide, i) => <button type="button" data-hero-slide={i} aria-label={`Show ${slide.label}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>)}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100svh;
    min-height: 40rem;
    background-color: var(--color--charcoal-black);
    color: var(--color--offwhite);
    overflow: clip;
  }

  .hero_image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .hero_image.is-active { opacity: 1;
  }

  /* Figma "overlay/bottom" — full-height fade to black */
  .hero_overlay-bottom {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0) 0%,
      rgb(0 0 0 / 0.66) 105.94%
    );
  }
  /* Figma "overlay/diagonal" — darkens the lower-left corner */
  .hero_overlay-diagonal {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      -51.03deg,
      rgb(0 0 0 / 0) 13.27%,
      rgb(0 0 0 / 0) 69.39%,
      rgb(0 0 0 / 0.66) 122.02%
    );
  }

  .hero_content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
    padding-bottom: 3rem;             /* 48 */
  }

  .hero_copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .75rem;
    max-width: 38.125rem;             /* 610 */
  }
  .hero_copy > :global(.hero_button) {
    margin-top: 1.25rem;                 /* 16 + 16 = 32 heading → button */
  }

  .hero_tagline {
    color: var(--color--sandy-gold);
  }
  .hero_dot {
    width: 0.1875rem;                 /* 3 */
    height: 0.1875rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  .hero_heading {
    color: var(--color--offwhite);
  }
  .hero_heading .hero_mask { display: block; }

  /* --- Load reveal: line masks. Hidden by CSS (before JS) only when JS will run. --- */
  .hero_mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    /* room for italic overhang + descenders, pulled back so layout is unchanged */
    padding: 0.05em 0.15em 0.2em 0.1em;
    margin: -0.05em -0.15em -0.2em -0.1em;
  }
  .hero_mask-inner {
    display: inline-block;
    transform: translateY(0);
  }
  .hero_tagline .hero_mask-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
  }
  :global(html.js) .hero_mask-inner { transform: translateY(130%); }
  :global(html.js) .hero_copy > :global(.hero_button),
  :global(html.js) .hero_content > :global(.hero_badge) { opacity: 0; }
  :global(html.js) .hero_image {
    transform: scale(1.06);
    filter: blur(5px);                /* rack-focus on load */
    will-change: transform, filter;
  }
  /* Once the load timeline finishes, drop the start state and the promoted layer */
  :global(html.js) .hero.is-loaded .hero_image {
    transform: none;
    filter: none;
    will-change: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero_mask-inner { transform: none; }
    :global(html.js) .hero_copy > :global(.hero_button),
    :global(html.js) .hero_content > :global(.hero_badge) { opacity: 1; }
    :global(html.js) .hero_image { transform: none; filter: none; }
  }
  .hero_heading em {
    font-style: italic;
  }

  .hero_content > :global(.hero_badge) { flex-shrink: 0; }

  /* --- Tablet --- */
  @media (max-width: 991px) {
    .hero_heading { font-size: 3.5rem; }
    .hero_content { padding-bottom: 2.5rem; }   /* 56 */
  }

  /* --- Mobile (no design yet — sensible default) --- */
  @media (max-width: 767px) {
    .hero { min-height: 40rem; }
    .hero_image { object-position: 71% center; }
    .hero_content {
      flex-direction: column;
      align-items: flex-start;
      padding-bottom: 1.5rem;
    }
    .hero_heading { font-size: 2.5rem; }  /* 44 */
    .hero_badge { display: none; }
    .hero_content { gap: 1.25rem; }
    .hero_controls { position: static; }
  }
  .hero_badge { position: relative; overflow: hidden; }
  .hero_badge-progress { position: absolute; inset: 0; background: var(--color--sandy-brown); transform: scaleX(var(--hero-progress, 0)); transform-origin: left; pointer-events: none; }
  .hero_badge-label { position: relative; z-index: 1; }
  .hero_controls { display: none; gap: .75rem; align-items: center; }
  .hero_pagination { display: flex; gap: .5rem; align-items: center; }
  .hero_pagination button { width: 1rem; height: .1875rem; background: var(--color--offwhite); opacity: .4; transition: width .4s, opacity .4s; position: relative; }
  .hero_pagination button::after { content: ''; position: absolute; inset: -.625rem 0; }
  .hero_pagination button[aria-pressed='true'] { width: 1.75rem; opacity: 1; }
  .hero_pause { font-size: .75rem; line-height: 1; padding: .375rem; }
  @media (max-width: 767px) { .hero_controls { display: flex; position: static; } }
  @media (prefers-reduced-motion: reduce) { .hero_image { transition: none; } }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero && !reducedMotion) {
    const image = hero.querySelector('.hero_image');
    const lines = hero.querySelectorAll('.hero_mask-inner');
    const button = hero.querySelector('.hero_button');
    const badge = hero.querySelector('.hero_badge');
    const nav = document.querySelector('.navbar');

    gsap.timeline({
      delay: 0.15,
      onComplete: () => {
        hero.classList.add('is-loaded');
        gsap.set(image, { clearProps: 'all' });
      },
    })
      .to(image, { scale: 1, duration: 2.4 }, 0)
      .to(image, { filter: 'blur(0px)', duration: 1.4 }, 0)
      .to(nav, { y: 0, opacity: 1, duration: 1 }, 0.2)
      .to(lines, { y: 0, duration: 1.1, stagger: 0.14 }, 0.35)
      .to(button, { opacity: 1, duration: 0.9 }, 0.95)
      .fromTo(button, { y: 12 }, { y: 0, duration: 0.9 }, 0.95)
      .to(badge, { opacity: 1, duration: 0.9 }, 1.05);
  }
</script>

<script>
  const slideshow = document.querySelector<HTMLElement>('.hero');
  if (slideshow) {
    const images = [...slideshow.querySelectorAll<HTMLImageElement>('[data-hero-image]')];
    const dots = [...slideshow.querySelectorAll<HTMLButtonElement>('[data-hero-slide]')];
    const label = slideshow.querySelector<HTMLElement>('[data-hero-label]');
    const names = ['Living', 'Bath', 'Rugs'];
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let paused = motionPreference.matches;
    const duration = 6500;
    let elapsed = 0;
    let lastTime: number | undefined;
    const progress = () => slideshow.style.setProperty('--hero-progress', String(elapsed / duration));
    const show = (index: number) => {
      active = index;
      elapsed = 0;
      lastTime = undefined;
      progress();
      images.forEach((image, i) => {
        image.classList.toggle('is-active', i === index);
        if (i === index) image.removeAttribute('aria-hidden'); else image.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-pressed', String(i === index)));
      if (label) label.textContent = `0${index + 1} / ${names[index]}`;
    };
    const tick = (now: number) => {
      if (!paused && !document.hidden) {
        if (lastTime !== undefined) elapsed += now - lastTime;
        if (elapsed >= duration) show((active + 1) % images.length);
        progress();
        lastTime = now;
      } else lastTime = undefined;
      requestAnimationFrame(tick);
    };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); }));
    slideshow.querySelector('.hero_badge')?.addEventListener('click', () => { show((active + 1) % images.length); });
    document.addEventListener('visibilitychange', () => { lastTime = undefined; });
    motionPreference.addEventListener('change', () => { paused = motionPreference.matches; lastTime = undefined; });
    requestAnimationFrame(tick);
  }
</script>
