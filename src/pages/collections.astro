---
import Lines from '../components/Lines.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CollectionGrid from '../components/CollectionGrid.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import CollectionEnd from '../components/CollectionEnd.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="The Collection — Crestloom Textile" description="Explore rugs, living textiles and linen through a changing edit of texture, material and craft.">
  <div class="collection-page site-responsive">
    <Navbar theme="dark" />
    <section class="collection padding-global" id="collections" data-reveal-section>
      <div class="container-large collection_inner">
        <header class="collection_header" data-reveal-group>
          <div class="collection_heading-block">
            <Lines class="text-style-tagline text-color-sandy-brown" lines={['The collection']} />
            <Lines tag="h1" class="heading-style-h1" lines={['Objects for living,', 'chosen with intention.']} />
          </div>
        </header>
        <CategoryFilter />
        <CollectionGrid />
        <CollectionEnd />
      </div>
    </section>
    <Footer directory />
  </div>
</Layout>
<style>
  .collection { background: var(--color--offwhite); padding-top: 12.5rem; padding-bottom: 6.25rem; }
  .collection_inner { display: flex; flex-direction: column; gap: 5rem; }
  .collection_header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .collection_heading-block { display: flex; flex-direction: column; gap: .75rem; width: 45rem; }
  @media (max-width: 991px) {
    .collection { padding-top: 10.375rem; padding-bottom: 4.5rem; }
    .collection_inner { gap: 3.5rem; }
    .collection_header { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .collection_heading-block { width: 100%; }
    .collection_heading-block :global(h1) { font-size: 3.5rem; line-height: 107.143%; }
    .collection_inner > :global(.collection-end) { padding-top: 2.5rem; }
  }
  @media (max-width: 767px) {
    .collection { padding: 8.4rem .96rem 3.84rem; }
    .collection_inner { gap: 2.88rem; }
    .collection_header { gap: 1.44rem; }
    .collection_heading-block { gap: .72rem; }
    .collection_heading-block :global(h1) { font-size: 2.4rem; line-height: 110%; }
    .collection_heading-block :global(.text-style-tagline) { font-size: .9rem; }
    .collection_inner > :global(.collection-end) { padding-top: 1.44rem; gap: 1.2rem; }
    .collection_inner > :global(.collection-end h2) { font-size: 1.92rem; line-height: 112.5%; }
    .collection_inner > :global(.collection-end p) { font-size: .96rem; }
    .collection_inner > :global(.collection-end .button) { font-size: .84rem; }
  }
</style>
